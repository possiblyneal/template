# LF in the repo and in every working tree, all platforms.
* text=auto eol=lf

# Windows scripts need CRLF to execute correctly.
*.bat text eol=crlf
*.cmd text eol=crlf

# SVG is markup; keep it diffable and reviewable.
*.svg text

# Show the enclosing heading in Markdown diff hunk headers.
*.md diff=markdown

# Collapse lockfiles on GitHub; local diffs and blame stay intact.
package-lock.json linguist-generated
pnpm-lock.yaml linguist-generated
yarn.lock linguist-generated
Cargo.lock linguist-generated
go.sum linguist-generated
uv.lock linguist-generated

# GitHub language statistics.
**/docs/** linguist-documentation
generated/** linguist-generated
vendor/** linguist-vendored
