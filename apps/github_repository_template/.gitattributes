# LF in the repo and in every working tree, all platforms.
* text=auto eol=lf

# Windows scripts need CRLF to execute correctly.
*.bat text eol=crlf
*.cmd text eol=crlf

# SVG is markup; keep it diffable and reviewable.
*.svg text

# Show the enclosing heading in Markdown diff hunk headers.
*.md diff=markdown

# Collapse lockfiles on GitHub; local diffs and blame stay intact.
package-lock.json linguist-generated=true
pnpm-lock.yaml linguist-generated=true
yarn.lock linguist-generated=true
Cargo.lock linguist-generated=true
go.sum linguist-generated=true
uv.lock linguist-generated=true

# GitHub language statistics.
**/docs/** linguist-documentation=true
generated/** linguist-generated=true
vendor/** linguist-vendored=true
