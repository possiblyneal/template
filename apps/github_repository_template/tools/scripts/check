#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root"

if [[ -x tools/scripts/doctor ]]; then
  tools/scripts/doctor
else
  echo "No tools/scripts/doctor script found; skipping environment checks."
fi

if [[ -x tools/ci/ci ]]; then
  tools/ci/ci
else
  echo "No tools/ci/ci script found; skipping CI checks."
fi
