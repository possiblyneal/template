#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root"

if [[ ! -x tools/scripts/doctor ]]; then
  echo "tools/scripts/doctor is missing or not executable."
  exit 1
fi

tools/scripts/doctor

if [[ ! -x tools/ci/ci ]]; then
  echo "tools/ci/ci is missing or not executable."
  exit 1
fi

tools/ci/ci
