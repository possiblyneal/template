#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root"

app_name="${1:-}"

if [[ -x tools/scripts/doctor ]]; then
  tools/scripts/doctor
else
  echo "No tools/scripts/doctor script found; skipping environment checks."
fi

if [[ -n "$app_name" && -d "apps/$app_name" ]]; then
  cd "apps/$app_name"
fi

if [[ -s package.json ]] && command -v npm >/dev/null 2>&1 && npm run --silent 2>/dev/null | grep -qE '^  dev$'; then
  npm run dev
elif [[ -s pyproject.toml ]] && command -v uv >/dev/null 2>&1; then
  echo "No Python dev command configured. Add project-specific server command to tools/scripts/dev."
elif [[ -s go.mod ]] || [[ -s ../../go.work ]]; then
  go run .
elif [[ -s Cargo.toml ]]; then
  cargo run
else
  echo "No dev command configured. Add project-specific dev server command to tools/scripts/dev."
fi
