#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root"

readonly NO_RUNNER=199

failed=()
unavailable=()

has_manifest() {
  [[ -s package.json || -s pyproject.toml || -s go.mod || -s go.work || -s Cargo.toml ||
     -s Package.swift || -s settings.gradle.kts || -s build.gradle.kts ]]
}

check_audit() {
  if [[ -s package-lock.json ]] && command -v npm >/dev/null 2>&1; then npm audit --audit-level=moderate; return; fi
  if [[ -s pnpm-lock.yaml ]] && command -v pnpm >/dev/null 2>&1; then pnpm audit --audit-level moderate; return; fi
  if [[ -s yarn.lock ]] && command -v yarn >/dev/null 2>&1; then yarn npm audit --severity moderate; return; fi
  if [[ -s pyproject.toml ]] && command -v uv >/dev/null 2>&1; then uv run pip-audit; return; fi
  if [[ -s go.mod || -s go.work ]] && command -v govulncheck >/dev/null 2>&1; then govulncheck ./...; return; fi
  if [[ -s Cargo.toml ]] && command -v cargo-audit >/dev/null 2>&1; then cargo audit; return; fi
  # Swift and Gradle have no first-party audit command. Trivy reads the
  # resolved lockfiles instead, so it is the runner for both. Gradle locking is
  # opt-in, so a repository without gradle.lockfile has no resolved versions to
  # audit and this reports no runner rather than scanning declared ranges.
  if [[ -s Package.resolved ]] && command -v trivy >/dev/null 2>&1; then
    trivy fs --exit-code 1 --severity HIGH,CRITICAL --scanners vuln Package.resolved
    return
  fi
  if [[ -n "$(find . -name gradle.lockfile -print -quit)" ]] && command -v trivy >/dev/null 2>&1; then
    trivy fs --exit-code 1 --severity HIGH,CRITICAL --scanners vuln .
    return
  fi
  return $NO_RUNNER
}

# A backstop, not the primary control. GitHub push protection blocks a secret
# before it reaches the remote; this only reports one that is already pushed,
# by which time rotation is the remedy. Run gitleaks from .pre-commit-config.yaml
# to catch secrets before the commit exists.
check_secrets() {
  if command -v gitleaks >/dev/null 2>&1; then
    gitleaks detect --source . --redact --verbose
    return
  fi
  return $NO_RUNNER
}

run_check() {
  local name="$1" fn="$2" status=0
  "$fn" || status=$?

  case "$status" in
    0) echo "pass         $name" ;;
    "$NO_RUNNER") echo "unavailable  $name"; unavailable+=("$name") ;;
    *) echo "FAIL         $name (exit $status)"; failed+=("$name") ;;
  esac
}

run_check dependency-audit check_audit
run_check secret-scan check_secrets

echo

if (( ${#failed[@]} > 0 )); then
  echo "Failed: ${failed[*]}"
  exit 1
fi

blocking=()
advisory_missing=()

for name in ${unavailable[@]+"${unavailable[@]}"}; do
  if [[ "$name" == "dependency-audit" ]] && has_manifest; then
    blocking+=("$name")
  else
    advisory_missing+=("$name")
  fi
done

if (( ${#advisory_missing[@]} > 0 )); then
  echo "Not run: ${advisory_missing[*]}"
  echo "Install the matching tool to enable these; they do not block on their own."
fi

if (( ${#blocking[@]} > 0 )); then
  echo
  echo "No runner for: ${blocking[*]}"
  echo "This repository has a project manifest, so a dependency audit is expected to run."
  echo "Install the audit tool for its language, or add a runner to tools/ci/security."
  exit 1
fi
