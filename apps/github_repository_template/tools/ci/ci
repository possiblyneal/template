#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root"

# Distinct from any exit code a real tool is likely to return, so "the tool
# reported a problem" is never confused with "no tool was available".
readonly NO_RUNNER=199

failed=()
unavailable=()

project_detected() {
  [[ -s package.json || -s pyproject.toml || -s go.mod || -s go.work || -s Cargo.toml ]]
}

# Reads package.json directly. `npm run` writes its listing to stderr and prints
# nothing under --silent, so parsing its output silently matches nothing.
has_npm_script() {
  [[ -s package.json ]] &&
    command -v node >/dev/null 2>&1 &&
    command -v npm >/dev/null 2>&1 &&
    node -e 'const s=require("./package.json").scripts||{};process.exit(s[process.argv[1]]?0:1)' "$1" 2>/dev/null
}

check_lint() {
  if has_npm_script lint; then npm run lint; return; fi
  if [[ -s pyproject.toml ]] && command -v uv >/dev/null 2>&1; then uv run ruff check .; return; fi
  if [[ -s go.mod || -s go.work ]]; then go vet ./...; return; fi
  if [[ -s Cargo.toml ]]; then cargo clippy -- -D warnings; return; fi
  return $NO_RUNNER
}

check_format() {
  if has_npm_script format:check; then npm run format:check; return; fi
  if [[ -s pyproject.toml ]] && command -v uv >/dev/null 2>&1; then uv run ruff format --check .; return; fi
  if [[ -s go.mod || -s go.work ]]; then
    local unformatted
    unformatted="$(gofmt -l .)"
    [[ -z "$unformatted" ]] || { echo "gofmt needed: $unformatted"; return 1; }
    return
  fi
  if [[ -s Cargo.toml ]]; then cargo fmt --check; return; fi
  return $NO_RUNNER
}

check_typecheck() {
  if has_npm_script typecheck; then npm run typecheck; return; fi
  if [[ -s pyproject.toml ]] && command -v uv >/dev/null 2>&1; then uv run mypy .; return; fi
  # Go and Rust type-check as part of build.
  if [[ -s go.mod || -s go.work || -s Cargo.toml ]]; then return; fi
  return $NO_RUNNER
}

check_test() {
  if has_npm_script test; then npm run test; return; fi
  if [[ -s pyproject.toml ]] && command -v uv >/dev/null 2>&1; then uv run pytest; return; fi
  if [[ -s go.mod || -s go.work ]]; then go test ./...; return; fi
  if [[ -s Cargo.toml ]]; then cargo test; return; fi
  return $NO_RUNNER
}

check_build() {
  if has_npm_script build; then npm run build; return; fi
  if [[ -s go.mod || -s go.work ]]; then go build ./...; return; fi
  if [[ -s Cargo.toml ]]; then cargo build --locked; return; fi
  # An interpreted project has nothing to build.
  if [[ -s pyproject.toml ]]; then return; fi
  return $NO_RUNNER
}

run_check() {
  local name="$1" fn="$2" status=0
  "$fn" || status=$?

  case "$status" in
    0) echo "pass         $name" ;;
    "$NO_RUNNER") echo "unavailable  $name"; unavailable+=("$name") ;;
    *) echo "FAIL         $name (exit $status)"; failed+=("$name") ;;
  esac
}

run_check lint check_lint
run_check format check_format
run_check typecheck check_typecheck
run_check test check_test
run_check build check_build

echo

if (( ${#failed[@]} > 0 )); then
  echo "Failed: ${failed[*]}"
  exit 1
fi

if (( ${#unavailable[@]} > 0 )); then
  if project_detected; then
    echo "No runner for: ${unavailable[*]}"
    echo "This repository has a project manifest, so these checks are expected to run."
    echo "Wire them up in tools/ci/ci, or add the missing tool to the CI workflow."
    exit 1
  fi
  echo "No project manifest found, so there is nothing to check yet."
  echo "Unavailable: ${unavailable[*]}"
  echo "These become required as soon as a manifest is added."
fi
