#!/usr/bin/env bash
set -euo pipefail

# Link this unit's skill into the clone's own skills directory, where Claude
# Code looks for it. The link is a deployment artifact rather than repository
# content -- .gitignore holds it out of the tree -- so every clone runs this
# once and nothing about the skill lives in two places.
#
# The target is src/ rather than the unit root: a skill directory is read as
# SKILL.md plus the paths beside it, and .unit.json is this repository's
# bookkeeping, not the skill's.

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
link="$repo_root/.claude/skills/repo-builder"
target="../../apps/repo-builder/src"

mkdir -p "$(dirname "$link")"

if [[ -L "$link" ]]; then
  [[ "$(readlink "$link")" == "$target" ]] && { echo "already linked: $link -> $target"; exit 0; }
  rm "$link"
elif [[ -e "$link" ]]; then
  echo "$link exists and is not a symlink; move it aside first" >&2
  exit 1
fi

ln -s "$target" "$link"
echo "linked: $link -> $target"
