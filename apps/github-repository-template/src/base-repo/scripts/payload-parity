#!/usr/bin/env bash
set -euo pipefail

# Compare the root's .github/ and scripts/ with the template payload. Runs from
# scripts/check and pre-commit; a repository without a payload is not-applicable.
# Unlike scripts/structure, this checks content as well as path presence.
#
# Dependabot's github-actions ecosystem reaches the root, so a routine bump can
# leave the payload pinned to an old SHA. Fail rather than update either copy;
# the same applies to hand edits. Comparing scripts/ also lets the ShellCheck
# hook skip the payload copy.
#
# Read paths and content from the Git index: pre-commit must judge the staged
# tree, not an unstaged fix or scratch edit in the working tree.

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

# shellcheck source-path=SCRIPTDIR
# shellcheck source=libs/result.sh
source "$repo_root/scripts/libs/result.sh"

payload_root="apps/github-repository-template/src/base-repo"
record_file=".repo-template.json"

# Content that differs deliberately, by named path rather than by pattern, so a
# second divergence cannot join it silently. Presence is still checked: the
# exception says the two copies may differ, not that either may be missing.
#
# .github/dependabot.yml is the one, and it differs twice. The payload ships no
# pyproject.toml, so its copy must not carry the root's uv entry -- an
# ecosystem naming a manifest that is not there fails the run rather than being
# skipped. And where a repository tracks a .pre-commit-config.yaml under a
# payload, its pre-commit entry names that second directory so a bump reaches
# both copies; a repository with no payload has no such directory to name.
content_exceptions=".github/dependabot.yml"

# A root file the payload deliberately lacks. scripts/CLAUDE.md is the one: it
# documents this repository's scripts, and the payload's root CLAUDE.md is what
# a generated repository reads instead.
root_only="scripts/CLAUDE.md"

# A payload file the root deliberately dropped. The record is
# .repo-template.json's generation.features, where the resolution is already
# written down; this table maps a feature name to the path its omission
# accounts for. Only a feature naming a file appears here -- features records
# deliberate absences of settings too, and those have no path.
feature_path() {
  case "$1" in
    codeql) echo ".github/workflows/codeql.yml" ;;
    *) return 1 ;;
  esac
}

# Membership in a newline-joined list of paths. One predicate for every list
# here, since each answers the same question about the same kind of value.
holds() {
  [[ $'\n'"$1"$'\n' == *$'\n'"$2"$'\n'* ]]
}

# Whether a path's staged content differs from HEAD's: which copy of a
# diverged pair was edited. A missing HEAD reads as edited, so a first commit
# names no direction.
staged_edit() {
  ! git diff --cached --quiet HEAD -- "$1" 2> /dev/null
}

# The command that mirrors a diverged pair, where the staged edit settles its
# direction: exactly one copy changed since HEAD. Otherwise nothing, since a
# merged root bump changes neither copy and an edit to both changes both, and
# guessing a direction there overwrites the newer copy. A staged deletion is
# such an edit, and is mirrored by removing the other copy.
mirror_command() {
  local root_copy="$1" payload_copy="$payload_root/$1" from to
  if staged_edit "$root_copy" && ! staged_edit "$payload_copy"; then
    from="$root_copy" to="$payload_copy"
  elif staged_edit "$payload_copy" && ! staged_edit "$root_copy"; then
    from="$payload_copy" to="$root_copy"
  else
    return 0
  fi
  if ! git cat-file -e ":$from" 2> /dev/null; then
    printf '; run: git rm %q' "$to"
    return 0
  fi
  printf '; run: mkdir -p %q && cp %q %q && git add %q %q' "${to%/*}" "$from" "$to" "$from" "$to"
}

# The paths under each tree, relative to the root: the payload's prefix is
# stripped, so one path names both copies. quotePath is off so a non-ASCII
# filename arrives literally rather than C-quoted into a path that does not
# exist.
tree_paths() {
  git -c core.quotePath=false ls-files "$@" | sed "s|^$payload_root/||"
}

if ! command -v git > /dev/null 2>&1; then
  result payload-parity unavailable "git is required to enumerate the two trees"
  tally
  exit
fi

if ! git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
  result payload-parity unavailable "$repo_root is not a Git repository; both trees are read from its index"
  tally
  exit
fi

root_paths="$(tree_paths .github scripts)"
payload_paths="$(tree_paths "$payload_root/.github" "$payload_root/scripts")"

if [[ -z "$payload_paths" ]]; then
  result payload-parity not-applicable "no template payload at $payload_root"
  tally
  exit
fi

# The payload files the root does not hold. These are the only findings the
# record can excuse, so resolving them first is what keeps the jq gate below
# narrow: a root-only file and a content difference are both answerable without
# jq, and reporting them unavailable would name the wrong reason.
payload_only=""
while IFS= read -r path; do
  [[ -n "$path" ]] || continue
  holds "$root_paths" "$path" || payload_only+="$path"$'\n'
done <<< "$payload_paths"

# Which of those omissions the record accounts for, resolved once.
omitted=""
if [[ -n "$payload_only" && -f "$record_file" ]]; then
  if ! command -v jq > /dev/null 2>&1; then
    result payload-parity unavailable "jq is required to read generation.features in $record_file"
    tally
    exit
  fi
  while IFS= read -r feature; do
    path="$(feature_path "$feature")" || continue
    omitted+="$path"$'\n'
  done < <(jq -r '.generation.features // {} | to_entries[] | select(.value == "omitted-by-choice") | .key' "$record_file")
fi

while IFS= read -r path; do
  [[ -n "$path" ]] || continue

  if ! holds "$payload_paths" "$path"; then
    holds "$root_only" "$path" ||
      record "$path is in the root and not in the payload; add it to $payload_root/$path$(mirror_command "$path")"
  elif holds "$payload_only" "$path"; then
    holds "$omitted" "$path" ||
      record "$path is in the payload and not in the root; mirror it, or record the omission under generation.features in $record_file"
  elif ! holds "$content_exceptions" "$path"; then
    # Readability is asked before content, because a process substitution's
    # exit status is invisible: an unmerged path makes git show fail, and
    # comparing the two empty streams it leaves behind would report agreement.
    if ! git cat-file -e ":$path" 2> /dev/null ||
      ! git cat-file -e ":$payload_root/$path" 2> /dev/null; then
      record "$path cannot be read from the index; finish the merge before asking whether the trees agree"
    elif ! cmp -s <(git show ":$path") <(git show ":$payload_root/$path"); then
      record "$path differs between the two trees; mirror the change into the other$(mirror_command "$path")"
    fi
  fi
done < <(printf '%s\n%s\n' "$root_paths" "$payload_paths" | sort -u)

verdict payload-parity "the root and payload .github/ and scripts/ trees agree"

if tally; then
  echo "The root and payload .github/ and scripts/ trees agree."
else
  echo "The root and payload .github/ and scripts/ trees have diverged; each finding above names the fix."
  exit 1
fi
