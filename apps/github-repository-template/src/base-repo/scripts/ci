#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

# shellcheck source-path=SCRIPTDIR
# shellcheck source=libs/detect.sh
source "$repo_root/scripts/libs/detect.sh"

orphans="$(language_capabilities check-orphans || true)"
if [[ -n "$orphans" ]]; then
  echo "FAIL          detection"
  echo
  echo "$orphans"
  exit 1
fi

if ! language_capabilities has-any; then
  echo "No project manifest found, so there is nothing to check yet."
  echo "Every check becomes required as soon as a manifest is added."
  exit 0
fi

args=()
[[ -z "${CI_DRY_RUN:-}" ]] || args+=(--dry-run)
status=0
language_capabilities run "${args[@]}" lint format-check typecheck test build || status=$?

[[ -z "${CI_DRY_RUN:-}" ]] || exit 0

case "$status" in
  0) ;;
  "$NO_RUNNER")
    echo
    echo "One or more required capabilities are unavailable."
    echo "Install the missing tool or add its private language adapter to scripts/libs/detect.sh."
    exit 1
    ;;
  *) exit "$status" ;;
esac
