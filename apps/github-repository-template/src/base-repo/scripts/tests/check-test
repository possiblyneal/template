status=$?
if (( status == 0 )) \
  && [[ "$(cat "$work/ci-args" 2>&1)" == "ci:--no-build" ]] \
  && grep -q 'chatter from doctor' <<< "$out"; then
  pass
else
  fail "wanted the streamed fast run, got exit $status: $out"
fi

