#!/usr/bin/env bash
set -uo pipefail

# What scripts/check prints, writes, and exits with. The gate's steps are
# stubbed in a scratch copy of the scripts, so the cases assert the wrapper's
# contract -- table and timings by default, the whole run in tmp/check.log every time,
# raw output under --verbose, the gate's own exit status, --fast handing ci
# --no-build -- and not the output of any real check.

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

# shellcheck source-path=SCRIPTDIR
# shellcheck source=libs/harness.sh
source "$repo_root/scripts/tests/libs/harness.sh"

echo "check-test"

# A scratch repository whose gate steps are stubs: every step chatters, ci
# then reports a lint line plus $2 (extra shell, e.g. a FAIL), and security
# exits with $3. The scratch repository has no pre-commit config, so that
# sweep stands down.
gate_fixture() {
  fixture "$1"
  local step
  for step in doctor script-tests structure payload-parity; do
    printf '#!/usr/bin/env bash\necho "chatter from %s"\n' "$step" > "$work/scripts/$step"
  done
  printf '#!/usr/bin/env bash\necho "lint               pass             python"\n%s\n' \
    "${2:-}" > "$work/scripts/ci"
  printf '#!/usr/bin/env bash\necho "chatter from security"\nexit %s\n' "${3:-0}" \
    > "$work/scripts/security"
  chmod +x "$work"/scripts/*
}

gate_fixture "default prints the Result table and drops the chatter"
out="$(cd "$work" && scripts/check 2>&1)"
status=$?
if (( status == 0 )) \
  && grep -qE '^lint +pass' <<< "$out" \
  && ! grep -q 'chatter' <<< "$out"; then
  pass
else
  fail "wanted the table alone and exit 0, got exit $status: $out"
fi

current="the concise summary and log include elapsed gate timings"
if grep -qE '^Elapsed wall time' <<< "$out" \
  && grep -qE '^doctor +[0-9]+s$' <<< "$out" \
  && grep -qE '^total +[0-9]+s$' <<< "$out" \
  && grep -qE '^Elapsed wall time' "$work/tmp/check.log"; then
  pass
else
  fail "wanted elapsed timings in both summary and log"
fi

current="verbose output contains the same elapsed section as the log"
out="$(cd "$work" && scripts/check --verbose 2>&1)"
if grep -qE '^Elapsed wall time' <<< "$out" && [[ "$out" == "$(cat "$work/tmp/check.log")" ]]; then
  pass
else
  fail "wanted elapsed timings in verbose output and its log"
fi

gate_fixture "script tests are timed over their lifetime rather than the wait"
printf '#!/usr/bin/env bash\nsleep 2\ntouch done\n' > "$work/scripts/script-tests"
# The variables belong to the generated fixture, not this test.
# shellcheck disable=SC2016
printf '#!/usr/bin/env bash\nfor ((i=0; i<${FIXTURE_WAIT_ATTEMPTS:-100}; i++)); do\n  [[ -e done ]] && break\n  sleep 0.1\ndone\nif [[ ! -e done ]]; then echo "timed out waiting for done" >&2; exit 1; fi\necho "lint               pass             python"\n' > "$work/scripts/ci"
out="$(cd "$work" && scripts/check 2>&1)"
if grep -qE '^script-tests +[1-9][0-9]*s$' <<< "$out"; then
  pass
else
  fail "wanted the script-tests lifetime even when ci waits for it: $out"
fi
current="timing fixture reports a missing readiness marker"
rm -f "$work/done"
(cd "$work" && FIXTURE_WAIT_ATTEMPTS=1 exec scripts/ci) > "$work/wait-output" 2>&1 &
wait_pid=$!
(sleep 2; kill "$wait_pid" 2>/dev/null) &
watchdog_pid=$!
wait "$wait_pid"
status=$?
kill "$watchdog_pid" 2>/dev/null || true
wait "$watchdog_pid" 2>/dev/null || true
out="$(cat "$work/wait-output")"
if (( status == 1 )) && grep -q 'timed out waiting for done' <<< "$out"; then
  pass
else
  fail "wanted a bounded diagnostic, got exit $status: $out"
fi

gate_fixture "per-language timings name only runners that ran"
cp "$repo_root/scripts/ci" "$repo_root/scripts/doctor" "$repo_root/scripts/security" "$work/scripts/"
printf '[project]\nname = "example"\nversion = "1"\n' > "$work/pyproject.toml"
printf '// swift-tools-version:5.9\n' > "$work/Package.swift"
stub uv <<'STUB'
#!/usr/bin/env bash
exit 0
STUB
stub swift <<'STUB'
#!/usr/bin/env bash
exit 0
STUB
out="$(cd "$work" && scripts/check --fast 2>&1)"
status=$?
if (( status == 0 )) \
  && grep -qE '^toolchain/python +[0-9]+s$' <<< "$out" \
  && grep -qE '^audit/python +[0-9]+s$' <<< "$out" \
  && grep -qE '^lint/python +[0-9]+s$' <<< "$out" \
  && grep -qE '^lint/swift +[0-9]+s$' <<< "$out" \
  && grep -qE '^lint +[0-9]+s$' <<< "$out" \
  && grep -qE '^format-check +[0-9]+s$' <<< "$out" \
  && grep -qE '^typecheck +[0-9]+s$' <<< "$out" \
  && grep -qE '^test +[0-9]+s$' <<< "$out" \
  && ! grep -qE '^(build([ /])|typecheck/swift )' <<< "$out"; then
  pass
else
  fail "wanted stage and per-language timings and no unrun stages, got exit $status: $out"
fi

current="a failed adapter timing write does not exit doctor early"
out="$(cd "$work" && CHECK_TIMING_FILE="$work/scripts" scripts/doctor 2>&1)"
status=$?
if (( status == 0 )) && grep -qE '^toolchain +pass +python$' <<< "$out"; then
  pass
else
  fail "wanted successful toolchain detection despite the unusable timing sink, got exit $status: $out"
fi

current="a capability with no applicable adapters emits no elapsed time"
mv "$work/pyproject.toml" "$work/pyproject.disabled"
out="$(cd "$work" && scripts/check --fast 2>&1)"
status=$?
if (( status == 0 )) && grep -qE '^typecheck +not-applicable +swift$' <<< "$out" \
  && ! grep -qE '^typecheck(/[a-z]+)? +[0-9]+s$' <<< "$out"; then
  pass
else
  fail "wanted a not-applicable typecheck and no elapsed time, got exit $status: $out"
fi

gate_fixture "doctor and security language timings reach the summary"
for step in doctor security; do
  # shellcheck disable=SC2016
  printf '#!/usr/bin/env bash\nprintf "%s/python 0s\\n" >> "${CHECK_TIMING_FILE:-/dev/null}"\n' "$step" > "$work/scripts/$step"
done
out="$(cd "$work" && scripts/check 2>&1)"
if grep -qE '^doctor/python +0s$' <<< "$out" && grep -qE '^security/python +0s$' <<< "$out"; then
  pass
else
  fail "wanted both language timings: $out"
fi

gate_fixture "timing write failure preserves the step status"
# shellcheck disable=SC2016
printf '#!/usr/bin/env bash\nfor d in tmp/check-timing.*; do mkdir "$d/stages"; done\nexit 9\n' > "$work/scripts/doctor"
out="$(cd "$work" && scripts/check --gate 2>&1)"
status=$?
if (( status == 9 )); then
  pass
else
  fail "wanted exit 9 despite a failed timing write, got $status: $out"
fi

gate_fixture "background and language timing write failures preserve results"
cp "$repo_root/scripts/ci" "$work/scripts/ci"
printf '[project]\nname = "example"\nversion = "1"\n' > "$work/pyproject.toml"
# shellcheck disable=SC2016
printf '#!/usr/bin/env bash\nmkdir "$CHECK_TIMING_FILE"\n' > "$work/scripts/doctor"
# shellcheck disable=SC2016
printf '#!/usr/bin/env bash\nfor d in tmp/check-timing.*; do mkdir "$d/script-tests"; done\nexit 3\n' > "$work/scripts/script-tests"
stub uv <<'STUB'
#!/usr/bin/env bash
exit 0
STUB
out="$(cd "$work" && scripts/check --gate --fast 2>&1)"
status=$?
if (( status == 3 )) && grep -qE '^lint +pass' <<< "$out"; then
  pass
else
  fail "wanted the original suite status and successful language results, got $status: $out"
fi

gate_fixture "only the final timing footer reaches the concise output"
printf '#!/usr/bin/env bash\nprintf "%%s\\n" "Elapsed wall time (overlapping stages are not additive):" "doctor 99s" "total 99s"\n' > "$work/scripts/doctor"
out="$(cd "$work" && scripts/check 2>&1)"
if grep -qE '^total +[0-9]+s$' <<< "$out" && ! grep -q '99s' <<< "$out"; then
  pass
else
  fail "wanted only the actual footer: $out"
fi

gate_fixture "nested summarize keeps elapsed timings on early failure"
printf '#!/usr/bin/env bash\nexit 9\n' > "$work/scripts/doctor"
out="$(cd "$work" && scripts/summarize scripts/check 2>&1)"
status=$?
if (( status == 9 )) && grep -qE '^total +[0-9]+s$' <<< "$out"; then
  pass
else
  fail "wanted exit 9 and timings from nested summarize: $out"
fi

current="summarize keeps timings when check is found on PATH"
out="$(cd "$work" && PATH="$work/scripts:$PATH" scripts/summarize check --verbose 2>&1)"
status=$?
if (( status == 9 )) && grep -qE '^total +[0-9]+s$' <<< "$out"; then
  pass
else
  fail "wanted exit 9 and timings from check on PATH: $out"
fi

# An ignored PIPE survives exec (as on hosted CI). Close the read end before
# releasing doctor so a runner's scheduling cannot accidentally drain the footer.
for mode in --gate --verbose; do
  gate_fixture "$mode cleans up after the reader closes with SIGPIPE ignored"
  printf '#!/usr/bin/env bash\necho first\nfor ((i=0; i<100; i++)); do\n  [[ -e reader-closed ]] && exit 9\n  sleep 0.02\ndone\nexit 1\n' > "$work/scripts/doctor"
  (
    cd "$work" || exit
    trap '' PIPE
    scripts/check "$mode" | (read -r _; exec 0<&-; touch reader-closed)
  ) 2>/dev/null
  status=$?
  if (( status == 9 )) && ! compgen -G "$work/tmp/check-timing.*" >/dev/null; then
    pass
  else
    fail "wanted doctor exit 9 and no timing directory, got $status"
  fi
done

gate_fixture "an early failure reports completed timings after unterminated output"
printf '#!/usr/bin/env bash\nprintf "doctor failed"\nexit 9\n' > "$work/scripts/doctor"
out="$(cd "$work" && scripts/check 2>&1)"
status=$?
if (( status == 9 )) && grep -qE '^doctor +[0-9]+s$' <<< "$out" \
  && grep -qE '^total +[0-9]+s$' <<< "$out" \
  && ! grep -qE '^(structure|security|script-tests) +[0-9]+s$' <<< "$out"; then
  pass
else
  fail "wanted exit 9 and only completed timings: $out"
fi

gate_fixture "the log holds the whole run after a passing run"
out="$(cd "$work" && scripts/check 2>&1)"
current="the log holds the whole run after a passing run"
log="$work/tmp/check.log"
if grep -q 'chatter from doctor' "$log" \
  && grep -q 'chatter from security' "$log" \
  && grep -qE '^lint +pass' "$log"; then
  pass
else
  fail "wanted every step's output in tmp/check.log, got: $(cat "$log" 2>&1)"
fi

gate_fixture "--verbose streams the whole run and writes the same log"
out="$(cd "$work" && scripts/check --verbose 2>&1)"
status=$?
if (( status == 0 )) \
  && grep -q 'chatter from doctor' <<< "$out" \
  && grep -qE '^lint +pass' <<< "$out" \
  && [[ "$out" == "$(cat "$work/tmp/check.log")" ]]; then
  pass
else
  fail "wanted the full run on stdout matching tmp/check.log, got exit $status: $out"
fi

gate_fixture "a failing gate exits non-zero and shows its FAIL" \
  'echo "audit              FAIL             1 violation(s)"; echo "                     apps/x has no manifest"; exit 1'
out="$(cd "$work" && scripts/check 2>&1)"
status=$?
if (( status != 0 )) \
  && grep -qE '^audit +FAIL' <<< "$out" \
  && grep -q 'apps/x has no manifest' <<< "$out" \
  && ! grep -q 'chatter' <<< "$out"; then
  pass
else
  fail "wanted a non-zero exit and the FAIL with its finding, got exit $status: $out"
fi

current="the log holds the whole run after a failing run"
if grep -q 'chatter from doctor' "$work/tmp/check.log" \
  && grep -qE '^audit +FAIL' "$work/tmp/check.log"; then
  pass
else
  fail "wanted the whole failing run in tmp/check.log"
fi

gate_fixture "--verbose passes the gate's exit status through" '' 7
(cd "$work" && scripts/check --verbose >/dev/null 2>&1)
status=$?
if (( status == 7 )); then
  pass
else
  fail "wanted the failing step's status 7, got $status"
fi

gate_fixture "a failing script test fails the gate after ci has run"
printf '#!/usr/bin/env bash\necho "chatter from script-tests"\nexit 3\n' > "$work/scripts/script-tests"
out="$(cd "$work" && scripts/check --verbose 2>&1)"
status=$?
if (( status == 3 )) \
  && grep -q 'chatter from script-tests' <<< "$out" \
  && grep -qE '^lint +pass' <<< "$out" \
  && ! grep -q 'chatter from security' <<< "$out"; then
  pass
else
  fail "wanted exit 3 with both outputs and no later step, got exit $status: $out"
fi

gate_fixture "ci failure takes precedence over a failing parallel suite" 'exit 4'
printf '#!/usr/bin/env bash\nexit 3\n' > "$work/scripts/script-tests"
out="$(cd "$work" && scripts/check --fast 2>&1)"
status=$?
if (( status == 4 )) && grep -qE '^script-tests +[0-9]+s$' <<< "$out" \
  && ! grep -qE '^security +[0-9]+s$' <<< "$out"; then
  pass
else
  fail "wanted ci exit 4 and no security timing, got exit $status: $out"
fi

gate_fixture "summarize still reads check" \
  'echo "audit              FAIL             1 violation(s)"; exit 1'
out="$(cd "$work" && scripts/summarize scripts/check 2>&1)"
status=$?
if (( status != 0 )) && grep -qE '^audit +FAIL' <<< "$out" && ! grep -q 'chatter' <<< "$out"; then
  pass
else
  fail "wanted the FAIL line and a non-zero exit through summarize, got exit $status: $out"
fi

gate_fixture "runs from a subdirectory"
mkdir -p "$work/sub"
out="$(cd "$work/sub" && ../scripts/check 2>&1)"
status=$?
if (( status == 0 )) && grep -qE '^lint +pass' <<< "$out"; then
  pass
else
  fail "wanted the table and exit 0 from a subdirectory, got exit $status: $out"
fi

# ci records the arguments it was given, so a case can tell the full gate from
# the fast one without running a real build.
ci_args_fixture() {
  gate_fixture "$1"
  printf '#!/usr/bin/env bash\necho "ci:$*" > ci-args\necho "lint               pass             python"\n' \
    > "$work/scripts/ci"
}

ci_args_fixture "the default gate runs ci whole"
(cd "$work" && scripts/check >/dev/null 2>&1)
if [[ "$(cat "$work/ci-args" 2>&1)" == "ci:" ]]; then
  pass
else
  fail "wanted ci with no arguments, got: $(cat "$work/ci-args" 2>&1)"
fi

ci_args_fixture "--fast leaves build to CI and says so in the log"
out="$(cd "$work" && scripts/check --fast 2>&1)"
status=$?
if (( status == 0 )) \
  && [[ "$(cat "$work/ci-args" 2>&1)" == "ci:--no-build" ]] \
  && grep -q 'chatter from security' "$work/tmp/check.log" \
  && grep -q 'build is left to CI' "$work/tmp/check.log" \
  && grep -qE '^lint +pass' <<< "$out"; then
  pass
else
  fail "wanted ci --no-build, every other step, and the log naming the skip, got exit $status: $out"
fi

ci_args_fixture "--fast and --verbose combine in either order"
