fixture "capability outcomes"
printf 'module example.com/m\n\ngo 1.22\n' > go.mod
out="$(language_capabilities run --dry-run lint typecheck)"
status=$?
if (( status == 0 )) &&
  grep -qx "would-run      lint go" <<<"$out" &&
  grep -qx "not-applicable typecheck go" <<<"$out"; then
  pass
else
  fail "the interface does not distinguish runnable and inapplicable capabilities"
fi
cleanup

fixture "python only"
printf '[project]\nname = "p"\nversion = "0.1.0"\n' > pyproject.toml
out="$(CI_DRY_RUN=1 scripts/ci)"
assert_dispatches python "$out"
assert_dispatches_delivery python
assert_absent node "$out"
cleanup

fixture "node only"
printf '{"name":"n","version":"1.0.0"}\n' > package.json
out="$(CI_DRY_RUN=1 scripts/ci)"
assert_dispatches node "$out"
assert_dispatches_delivery node
assert_absent python "$out"
