#!/usr/bin/env bash
set -uo pipefail

# Guards the one bug this detection work exists to prevent: a repository that
# gains a second language has that language silently skipped while the run stays
# green. Nothing else here fails visibly when it regresses, which is why it is
# worth a test at all.
#
# Every case runs against CI_DRY_RUN, which reports the check and language pairs
# scripts/ci would dispatch and runs none of them. Dispatch comes from
# wiring alone, so this is the same result on any machine and in CI, with no
# toolchain installed for any language under test.
#
# Not `set -e`: a failing assertion is recorded and the remaining cases still
# run, so one break does not hide the rest.

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

# Sourced before any fixture changes directory, so the path stays valid.
# shellcheck source-path=SCRIPTDIR
# shellcheck source=libs/harness.sh
source "$repo_root/scripts/tests/libs/harness.sh"

# Each case runs in its own directory holding nothing but the manifests it
# names, so a fixture cannot see another's files or this repository's.
fixture() {
  current="$1"
  work="$(mktemp -d)"
  cp -r "$repo_root/scripts" "$work/"
  cd "$work" || exit 1
}

# Overrides the harness version, which every other suite uses as-is. This one
# cd's into the fixture, so the directory has to be left before it is removed.
cleanup() {
  cd /
  [[ -n "${work:-}" && "$work" == /tmp/* ]] && rm -rf "$work"
}

assert_dispatches() {
  local lang="$1" out="$2" check expected
  for check in lint format-check typecheck test build; do
    expected=would-run
    case "$check:$lang" in
      typecheck:go|typecheck:rust|typecheck:swift|typecheck:kotlin|build:python)
        expected=not-applicable
        ;;
    esac

    if ! grep -qE "^${expected} +$check $lang$" <<<"$out"; then
      fail "$check does not report $expected for $lang"
      return
    fi
  done
  pass
}

# scripts/ci dispatches the gate alone, and neither run nor package is in it:
# starting a program is not a check and neither is building one. Both still go
# through the same mechanism, so they are asked for directly and the dry run
# reports the pairing without invoking an adapter.
assert_dispatches_delivery() {
  local lang="$1" check out
  out="$(language_capabilities run --dry-run run package)"
  for check in run package; do
    if ! grep -qE "^would-run +$check $lang$" <<<"$out"; then
      fail "$check does not dispatch for $lang"
      return
    fi
  done
  pass
}

assert_absent() {
  local lang="$1" out="$2"
  if grep -q " $lang\$" <<<"$out"; then
    fail "$lang dispatches in a repository that does not contain it"
    return
  fi
  pass
}

echo "capabilities-test"

# The supported set is the module's interface. Callers do not know its private
# per-language adapters; adding a language changes this one public answer.
# shellcheck source-path=SCRIPTDIR/..
# shellcheck source=libs/detect.sh
source "$repo_root/scripts/libs/detect.sh"
current="supported languages"
expected=$'node\npython\ngo\nrust\nswift\nkotlin'
if [[ "$(language_capabilities supported)" == "$expected" ]]; then
  pass
else
  fail "the interface does not report the six supported languages in order"
fi

