# Package.resolved and gradle.lockfile only exist once a package has resolved
# dependencies or Gradle locking is turned on, neither of which is guaranteed.
# No lockfile means nothing to scan, which must read as not-applicable rather
# than as a missing tool -- the tool may well be installed.
fixture "swift audit with no Package.resolved is not-applicable"
mkdir -p apps/ios
printf '// swift-tools-version:5.9\n' > apps/ios/Package.swift
out="$(language_capabilities run --dry-run audit 2>&1)"
if grep -qE '^not-applicable +audit swift$' <<<"$out"; then
  pass
else
  fail "a Swift package with no Package.resolved reports audit as unavailable instead of not-applicable"
fi
cleanup

fixture "kotlin audit with no gradle.lockfile is not-applicable"
printf 'rootProject.name = "k"\n' > settings.gradle.kts
out="$(language_capabilities run --dry-run audit 2>&1)"
if grep -qE '^not-applicable +audit kotlin$' <<<"$out"; then
  pass
else
  fail "a Gradle project with no gradle.lockfile reports audit as unavailable instead of not-applicable"
fi
cleanup

# --- a stream reader inside trivy_each/swift_each must not steal the manifest list --

# The manifest list is read on fd 3 specifically because the command run per
# manifest may itself read stdin. If it read fd 0 instead, a command that
# drains stdin would consume the remaining manifest list and silently skip
# every package after the first.
#
# Each helper is invoked with `</dev/null` so the stub drains an empty stdin
# rather than the suite's own, which it would otherwise block on until the
# caller closed it. scripts/CLAUDE.md carries the rule and why the redirect
# leaves the assertion above intact.
fixture "swift_each visits every package even when the command reads stdin"
mkdir -p apps/a apps/b bin
printf '// swift-tools-version:5.9\n' > apps/a/Package.swift
printf '// swift-tools-version:5.9\n' > apps/b/Package.swift
marker="$PWD/marker"
: > "$marker"
cat > bin/swift <<EOF
#!/usr/bin/env bash
cat >/dev/null
echo ok >> "$marker"
EOF
chmod +x bin/swift
PATH="$PWD/bin:$PATH" swift_each swift test </dev/null
if (( $(wc -l < "$marker") == 2 )); then
  pass
else
  fail "swift_each visited $(wc -l < "$marker") of 2 packages when the command reads stdin"
fi
cleanup

fixture "trivy_each scans every lockfile even when the command reads stdin"
mkdir -p apps/a apps/b bin
printf 'lock\n' > apps/a/gradle.lockfile
printf 'lock\n' > apps/b/gradle.lockfile
marker="$PWD/marker"
: > "$marker"
cat > bin/trivy <<EOF
#!/usr/bin/env bash
cat >/dev/null
echo ok >> "$marker"
EOF
chmod +x bin/trivy
PATH="$PWD/bin:$PATH" trivy_each gradle.lockfile </dev/null
if (( $(wc -l < "$marker") == 2 )); then
  pass
else
  fail "trivy_each scanned $(wc -l < "$marker") of 2 lockfiles when the command reads stdin"
fi
cleanup

# --- go checks must reach a module that is not at the repository root --------

# `./...` matches only packages inside a module, and the root of a Go workspace
# is not itself in one, so a single `go build ./...` from the root refuses the
# pattern and exits 1 -- every Go check failing on the invocation rather than on
# the code. go_each enters each module instead. The stub consumes stdin, so
# this also covers the module list being read on fd 3 rather than fd 0, and is
# invoked with `</dev/null` for the reason given above it.
fixture "go_each runs the command in every workspace module"
marker="$PWD/visited"
: > "$marker"
mkdir -p bin apps/one apps/two
cat > bin/go <<EOF
#!/usr/bin/env bash
if [[ "\$1" == list ]]; then
  printf '%s\n' "$PWD/apps/one" "$PWD/apps/two"
  exit 0
fi
cat >/dev/null
pwd >> "$marker"
EOF
chmod +x bin/go
PATH="$PWD/bin:$PATH" _capability_build_go </dev/null
status=$?
# Two conditions, two messages: a status-only failure that printed the visited
# list would send the next reader hunting for a visiting bug that is not there.
if (( status != 0 )); then
  fail "go_each returned $status though every stubbed module succeeded"
elif [[ "$(tr '\n' ' ' < "$marker")" == "$PWD/apps/one $PWD/apps/two " ]]; then
  pass
else
  fail "go_each visited $(tr '\n' ' ' < "$marker")rather than both workspace modules"
fi
cleanup

# A listing that fails means the module graph could not be read. Reporting that
# as a pass is the silent green run this helper exists to prevent.
fixture "a failed module listing is not read as a passing build"
mkdir -p bin apps/one
cat > bin/go <<EOF
#!/usr/bin/env bash
# Fails the listing only. Every other invocation succeeds, so the case cannot
# pass by the build itself failing.
if [[ "\$1" == list ]]; then
  printf '%s\n' "$PWD/apps/one"
  exit 1
fi
exit 0
EOF
chmod +x bin/go
if PATH="$PWD/bin:$PATH" _capability_build_go >/dev/null 2>&1; then
  fail "a failed module listing was reported as a passing build"
else
  pass
fi
cleanup

# An empty listing is the same failure wearing a zero exit status: no module was
# entered, so nothing was built.
fixture "an empty module listing is not read as a passing build"
mkdir bin
cat > bin/go <<'EOF'
#!/usr/bin/env bash
exit 0
EOF
chmod +x bin/go
if PATH="$PWD/bin:$PATH" _capability_build_go >/dev/null 2>&1; then
  fail "an empty module listing was reported as a passing build"
else
  pass
fi
cleanup

# --- the go run adapter must find the main package, not assume it is here ----

# `go run .` needs a main package in the current directory. The workspace root
# has none, and a unit whose entry point sits under src/ has none at its own
# root either, so the command reported `no Go files` in both places.
#
# The `go list` stub here drains stdin as well, so these three are invoked with
