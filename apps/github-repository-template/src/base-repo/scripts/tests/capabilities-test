# --- the Node run adapter chooses between two programs ------------------------

# The run dispatch is a no-op in Go, Rust and Kotlin, so these are the cases
# that show it is not dead weight: the same unit, the same directory, and a
# different program depending on the declared fact. The adapter is called
# directly rather than through scripts/run, because what is under test is which
# program it picks, and scripts/tests/unit-commands-test already covers how a
# unit is resolved and how CI_DRY_RUN reports the pairing.
if command -v node > /dev/null 2>&1 && command -v npm > /dev/null 2>&1; then
  fixture "a one-shot runs the entry point bin names"
  printf '{"name":"n","version":"1.0.0","bin":{"n":"./cli.js"}}\n' > package.json
  printf 'console.log("cli:" + process.argv.slice(2).join(","));\n' > cli.js
  unit_run=oneshot unit_args=(--flag value)
  out="$(_capability_run_node 2>&1)"
  status=$?
  unset unit_run unit_args
  if (( status == 0 )) && grep -qx 'cli:--flag,value' <<<"$out"; then
    pass
  else
    fail "a one-shot did not run its bin entry with the arguments after --: $out"
  fi
  cleanup

  fixture "several bin entries are refused by name"
  printf '{"name":"n","version":"1.0.0","bin":{"a":"./a.js","b":"./b.js"}}\n' > package.json
  unit_run=oneshot
  out="$(_capability_run_node 2>&1)"
  status=$?
  unset unit_run
  if (( status == 1 )) && grep -q 'node ./a.js' <<<"$out" && grep -q 'node ./b.js' <<<"$out"; then
    pass
  else
    fail "several bin entries did not refuse and name each one: $out"
  fi
  cleanup

  # A one-shot that is not a CLI -- a script, a scheduled job -- names no bin,
  # and npm start is the only thing left that says how it starts.
  fixture "a one-shot with no bin falls back to npm start"
  printf '{"name":"n","version":"1.0.0","scripts":{"start":"echo started"}}\n' > package.json
  unit_run=oneshot
  out="$(_capability_run_node 2>&1)"
  status=$?
  unset unit_run
  if (( status == 0 )) && grep -q 'started' <<<"$out"; then
    pass
  else
    fail "a one-shot with no bin did not fall back to npm start: $out"
  fi
  cleanup

  # A TypeScript bin conventionally names build output, which a fresh clone does
  # not have. Node's own failure for that is a module-not-found trace naming a
  # file rather than the build that was never run, and the unit is well-formed
  # and the command correct -- so the absence is caught here and what to do is
  # named. Nothing about it is TypeScript-specific: the condition is a bin that
  # is not on disk, and a plain JavaScript unit whose bin is a source file never
  # reaches it.
  fixture "a bin that is not built names the build rather than failing in node"
  printf '{"name":"n","version":"1.0.0","bin":{"n":"./dist/cli.js"},"scripts":{"build":"echo built"}}\n' > package.json
  unit_run=oneshot
  out="$(_capability_run_node 2>&1)"
  status=$?
  unset unit_run
  if (( status == 0 )); then
    fail "a bin pointing at output that is not built was treated as runnable: $out"
  elif grep -q 'MODULE_NOT_FOUND\|Cannot find module' <<<"$out"; then
    fail "the failure was node's rather than the adapter's: $out"
  elif grep -q './dist/cli.js' <<<"$out" && grep -q 'npm run build' <<<"$out"; then
    pass
  else
    fail "the refusal named neither the missing path nor the build command: $out"
  fi
  cleanup

  # The same absence in a package that builds nothing. Naming a build command
  # that does not exist would send whoever is holding the failure to a command
  # that fails differently.
  fixture "a bin that is not built and no build script says so"
  printf '{"name":"n","version":"1.0.0","bin":{"n":"./dist/cli.js"}}\n' > package.json
  unit_run=oneshot
  out="$(_capability_run_node 2>&1)"
  status=$?
  unset unit_run
  if (( status == 0 )); then
    fail "a bin pointing at a file that is not there was treated as runnable: $out"
  elif grep -q 'MODULE_NOT_FOUND\|Cannot find module' <<<"$out"; then
    fail "the failure was node's rather than the adapter's: $out"
  elif grep -q './dist/cli.js' <<<"$out" && ! grep -q 'npm run build' <<<"$out"; then
    pass
  else
    fail "a missing bin with no build script named a build command anyway: $out"
  fi
  cleanup

  # has_npm_script needs npm on the PATH, so with node installed and npm not it
  # is false for the tool rather than for package.json. Saying the package names
  # no build script would then be a fact about the file asserted from a missing
  # tool, so that branch stays quiet and the line above it -- true either way --
  # is the whole refusal.
  fixture "a missing npm is not reported as a missing build script"
  printf '{"name":"n","version":"1.0.0","bin":{"n":"./dist/cli.js"},"scripts":{"build":"echo built"}}\n' > package.json
  mkdir -p node-only
  ln -s "$(command -v node)" node-only/node
  unit_run=oneshot
  out="$(PATH="$PWD/node-only" _capability_run_node 2>&1)"
  status=$?
  unset unit_run
  if (( status == 0 )); then
    fail "a bin pointing at output that is not built was treated as runnable: $out"
  elif grep -q 'no build script' <<<"$out"; then
    fail "an npm that is not installed was reported as a package that has no build script: $out"
  elif grep -q './dist/cli.js' <<<"$out"; then
    pass
  else
    fail "the refusal did not name the missing path: $out"
  fi
  cleanup

  # The bug the dispatch prevents, from the other side: a package that ships a
  # CLI and also serves is started as the service it declared itself to be.
  fixture "a long-lived unit runs the dev server even with a bin"
  printf '{"name":"n","version":"1.0.0","bin":{"n":"./cli.js"},"scripts":{"dev":"echo serving"}}\n' > package.json
  printf 'console.log("cli");\n' > cli.js
  unit_run=longlived
  out="$(_capability_run_node 2>&1)"
  status=$?
  unset unit_run
  if (( status == 0 )) && grep -q 'serving' <<<"$out" && ! grep -qx 'cli' <<<"$out"; then
    pass
  else
    fail "a long-lived unit ran the CLI entry instead of the dev server: $out"
  fi
  cleanup
else
  current="the Node run adapter"
  skip "node or npm is not installed"
fi

# --- an impossible build is not a broken install -----------------------------

# The distinction the package capability exists to keep: a target this host
# cannot reach is not-applicable with the reason named, and a language with no
# adapter wired is unavailable. Both produce no file, which is why collapsing
# them is easy and wrong -- one is a fact about the host, the other a gap in
# this repository.
if command -v go > /dev/null 2>&1; then
  fixture "an unreachable target is not-applicable, an unwired language is unavailable"
  printf 'module example.com/t\n\ngo 1.22\n' > go.mod
  printf 'package main\n\nfunc main() {}\n' > main.go
  unit_targets=(windows-arm64)
  out="$(_capability_package_go 2>&1)"
  status=$?
  _capability_package_python
  python_status=$?
  unset unit_targets
  if (( status != 0 )); then
    fail "an unreachable target failed the build instead of being skipped: $out"
  elif ! grep -q 'not-applicable' <<<"$out" || ! grep -q 'windows-arm64' <<<"$out"; then
    fail "an unreachable target was not reported not-applicable by name: $out"
  elif (( python_status != NO_RUNNER )); then
    fail "an unwired language did not report the no-runner sentinel (exit $python_status)"
  else
    pass
  fi
  cleanup
else
  current="the package target outcomes"
  skip "go is not installed"
fi

# --- aggregate outcomes ------------------------------------------------------

fixture "unavailable capability"
printf '{"name":"n","version":"1.0.0"}\n' > package.json
out="$(language_capabilities run lint 2>&1)"
status=$?
if (( status == NO_RUNNER )) && grep -qE '^unavailable +lint node$' <<<"$out"; then
  pass
else
  fail "an absent runner is not reported as unavailable with the sentinel status"
fi
cleanup

fixture "failure does not stop polyglot dispatch"
printf '{"name":"n","version":"1.0.0","scripts":{"lint":"exit 7"}}\n' > package.json
printf '[project]\nname = "p"\nversion = "0.1.0"\n' > pyproject.toml
mkdir bin
cat > bin/uv <<'EOF'
#!/usr/bin/env bash
if [[ "${3:-}" == "--version" ]]; then exit 0; fi
if [[ "${1:-}" == "run" && "${2:-}" == "--quiet" ]]; then exit 0; fi
if [[ "${1:-}" == "run" && "${2:-}" == "ruff" ]]; then exit 0; fi
exit 1
EOF
chmod +x bin/uv
out="$(PATH="$PWD/bin:$PATH" language_capabilities run lint 2>&1)"
status=$?
if (( status == 1 )) &&
  grep -qE '^FAIL \(exit 7\) +lint node$' <<<"$out" &&
  grep -qE '^pass +lint python$' <<<"$out"; then
  pass
else
  fail "a failed adapter hides a later language or returns the wrong aggregate status"
fi
cleanup

