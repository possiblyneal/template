#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

# Sourced by absolute path so this works from any working directory, and marked
# SCRIPTDIR-relative so shellcheck follows it without being run from the root.
# shellcheck source-path=SCRIPTDIR
# shellcheck source=libs/detect.sh
source "$repo_root/scripts/libs/detect.sh"

app_name="${1:-}"

dev_node() { has_npm_script dev || return "$NO_RUNNER"; npm run dev; }
# uv has no dev server of its own, and which one a project runs depends on the
# framework, so there is nothing to default to here.
dev_python() { return "$NO_RUNNER"; }
dev_go() { go run .; }
dev_rust() { cargo run; }
dev_swift() { return "$NO_RUNNER"; }
dev_kotlin() { gradle_has_task run || return "$NO_RUNNER"; ./gradlew run; }

# Lists what the user can pass as an app name, so the error below names real
# choices rather than describing the argument in the abstract.
list_apps() {
  local entry found=1

  for entry in apps/*/; do
    [[ -d "$entry" ]] || continue
    found=0
    echo "  scripts/dev $(basename "$entry")"
  done

  return "$found"
}

if [[ -x scripts/doctor ]]; then
  scripts/doctor
else
  echo "No scripts/doctor script found; skipping environment checks."
fi

# A name that matches no directory used to be ignored, which started the root
# dev server instead — the wrong process, reported as a success.
if [[ -n "$app_name" ]]; then
  if [[ ! -d "apps/$app_name" ]]; then
    echo "No apps/$app_name directory."
    if list_apps >/dev/null; then
      echo "Available:"
      list_apps
    else
      echo "apps/ has no entries yet."
    fi
    exit 1
  fi
  cd "apps/$app_name"
fi

mapfile -t languages < <(detect_present_languages)

# A dev server is one foreground process, so with several stacks present there
# is no right one to pick and picking silently starts the wrong one. Naming the
# app is the only thing that resolves it, so it is required rather than guessed.
if (( ${#languages[@]} > 1 )); then
  echo "Several stacks here: ${languages[*]}"
  echo "A dev server is a single foreground process, so which one to start has to be said."
  if [[ -n "$app_name" ]]; then
    echo "apps/$app_name holds more than one stack. Split it, or add a dev script that"
    echo "starts what this app means by dev."
  elif list_apps >/dev/null; then
    echo "Name the app:"
    list_apps
  else
    echo "apps/ has no entries yet, so there is nothing to name. Add a dev script for"
    echo "the stack you mean to scripts/dev."
  fi
  exit 1
fi

if (( ${#languages[@]} == 0 )); then
  echo "No project manifest found here, so there is no dev server to start."
  exit 0
fi

lang="${languages[0]}"
status=0
"dev_${lang}" || status=$?

# The exit is conditional rather than a trailing `exit "$status"`, which reads
# the same but makes shellcheck treat every dev_<language> body above as
# unreachable, since it cannot see through dispatch by name.
if (( status == NO_RUNNER )); then
  echo "No dev command configured for $lang. Add one to scripts/dev."
elif (( status != 0 )); then
  exit "$status"
fi
