{
  "permissions": {
    "allow": [],
    "ask": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git rebase:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh release:*)",
      "Bash(gh repo delete:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(.env.development)",
      "Read(.env.staging)",
      "Read(.env.production)",
      "Read(.env.test)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(id_rsa*)",
      "Read(*.p12)",
      "Read(*.pfx)",
      "Read(credentials.json)",
      "Read(service-account*.json)",
      "Read(.npmrc)",
      "Read(.pypirc)",
      "Read(*.tfstate)",
      "Read(*.tfstate.*)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(.env.*.local)",
      "Edit(.env.development)",
      "Edit(.env.staging)",
      "Edit(.env.production)",
      "Edit(.env.test)",
      "Edit(*.pem)",
      "Edit(*.key)",
      "Edit(id_rsa*)",
      "Edit(*.p12)",
      "Edit(*.pfx)",
      "Edit(credentials.json)",
      "Edit(service-account*.json)",
      "Edit(.npmrc)",
      "Edit(.pypirc)",
      "Edit(*.tfstate)",
      "Edit(*.tfstate.*)"
    ],
    "additionalDirectories": []
  },
  "env": {},
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/ask-outside-repo.sh"
          }
        ]
      }
    ]
  },
  "sandbox": {},
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "enabledPlugins": {},
  "modelOverrides": {},
  "skillOverrides": {}
}
