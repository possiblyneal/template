{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [],
    "ask": [
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git rebase:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh release:*)",
      "Bash(gh repo delete:*)",
      "Bash(rm:*)",
      "Bash(git rm:*)",
      "Edit(.*)",
      "Edit(.*/**)",
      "Edit(**/.*)",
      "Edit(**/.*/**)",
      "Edit(**/src/**)",
      "Edit(/*)",
      "Read(//**/.npmrc)",
      "Read(//**/.pypirc)",
      "Edit(//**/.npmrc)",
      "Edit(//**/.pypirc)"
    ],
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.*.local)",
      "Read(//**/.env.development)",
      "Read(//**/.env.staging)",
      "Read(//**/.env.production)",
      "Read(//**/.env.test)",
      "Read(//**/.env.bak*)",
      "Read(//**/.credentials.json)",
      "Read(//**/.ssh/**)",
      "Read(//**/secrets/**)",
      "Read(//**/id_rsa*)",
      "Read(//**/id_ed25519*)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(//**/*.p12)",
      "Read(//**/*.pfx)",
      "Read(//**/credentials.json)",
      "Read(//**/service-account*.json)",
      "Read(//**/*.tfstate)",
      "Read(//**/*.tfstate.*)",
      "Edit(//**/.env)",
      "Edit(//**/.env.local)",
      "Edit(//**/.env.*.local)",
      "Edit(//**/.env.development)",
      "Edit(//**/.env.staging)",
      "Edit(//**/.env.production)",
      "Edit(//**/.env.test)",
      "Edit(//**/.env.bak*)",
      "Edit(//**/.credentials.json)",
      "Edit(//**/.ssh/**)",
      "Edit(//**/secrets/**)",
      "Edit(//**/id_rsa*)",
      "Edit(//**/id_ed25519*)",
      "Edit(//**/*.pem)",
      "Edit(//**/*.key)",
      "Edit(//**/*.p12)",
      "Edit(//**/*.pfx)",
      "Edit(//**/credentials.json)",
      "Edit(//**/service-account*.json)",
      "Edit(//**/*.tfstate)",
      "Edit(//**/*.tfstate.*)"
    ],
    "additionalDirectories": []
  },
  "env": {
    "CLAUDE_CODE_ALT_SCREEN_FULL_REPAINT": "1",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "185000",
    "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_ENABLE_FINE_GRAINED_TOOL_STREAMING": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_GLOB_HIDDEN": "1",
    "DISABLE_EXTRA_USAGE_COMMAND": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_INSTALL_GITHUB_APP_COMMAND": "1",
    "DISABLE_LOGOUT_COMMAND": "1",
    "DISABLE_UPGRADE_COMMAND": "1",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "0"
  },
  "plansDirectory": "./docs/plans",
  "allowedHttpHookUrls": [],
  "disableClaudeAiConnectors": true,
  "skipDangerousModePermissionPrompt": true,
  "hooks": {},
  "sandbox": {},
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "enabledPlugins": {},
  "modelOverrides": {},
  "skillOverrides": {}
}
