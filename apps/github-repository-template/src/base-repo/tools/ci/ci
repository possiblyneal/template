#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root"

# Distinct from any exit code a real tool is likely to return, so "the tool
# reported a problem" is never confused with "no tool was available".
readonly NO_RUNNER=199

failed=()
unavailable=()

project_detected() {
  [[ -s package.json || -s pyproject.toml || -s go.mod || -s go.work || -s Cargo.toml ]] ||
    has_swift || is_gradle
}

is_gradle() {
  [[ -s settings.gradle.kts || -s build.gradle.kts ]]
}

# Every other language here has a root manifest. SwiftPM has no workspace file,
# so packages sit at apps/<name>/ and libs/<name>/ and are found by search.
# .build holds checked-out dependencies, each with a Package.swift of its own.
swift_find() {
  find . -name "$1" -not -path '*/.build/*' "${@:2}"
}

has_swift() {
  [[ -n "$(swift_find Package.swift -print -quit)" ]]
}

# Every package runs, rather than stopping at the first failure, so one broken
# package does not hide the state of the rest.
swift_each() {
  local manifest status=0
  while IFS= read -r manifest; do
    ( cd "$(dirname "$manifest")" && "$@" ) || status=1
  done < <(swift_find Package.swift -print)
  return "$status"
}

# Gradle exposes lint and format tasks only when the matching plugin is applied,
# so the task list decides which checks exist. Listing costs a daemon start, so
# the result is read once and reused.
gradle_tasks=""
gradle_has_task() {
  is_gradle && [[ -x ./gradlew ]] || return 1
  [[ -n "$gradle_tasks" ]] || gradle_tasks="$(./gradlew -q tasks --all 2>/dev/null || true)"
  grep -qE "^$1( |$)" <<<"$gradle_tasks"
}

# Reads package.json directly. `npm run` writes its listing to stderr and prints
# nothing under --silent, so parsing its output silently matches nothing.
has_npm_script() {
  [[ -s package.json ]] &&
    command -v node >/dev/null 2>&1 &&
    command -v npm >/dev/null 2>&1 &&
    node -e 'const s=require("./package.json").scripts||{};process.exit(s[process.argv[1]]?0:1)' "$1" 2>/dev/null
}

check_lint() {
  if has_npm_script lint; then npm run lint; return; fi
  if [[ -s pyproject.toml ]] && command -v uv >/dev/null 2>&1; then uv run ruff check .; return; fi
  if [[ -s go.mod || -s go.work ]]; then go vet ./...; return; fi
  if [[ -s Cargo.toml ]]; then cargo clippy -- -D warnings; return; fi
  if has_swift && command -v swift >/dev/null 2>&1; then swift_each swift format lint --recursive --strict .; return; fi
  if gradle_has_task ktlintCheck; then ./gradlew ktlintCheck; return; fi
  if gradle_has_task detekt; then ./gradlew detekt; return; fi
  return $NO_RUNNER
}

check_format() {
  if has_npm_script format:check; then npm run format:check; return; fi
  if [[ -s pyproject.toml ]] && command -v uv >/dev/null 2>&1; then uv run ruff format --check .; return; fi
  if [[ -s go.mod || -s go.work ]]; then
    local unformatted
    unformatted="$(gofmt -l .)"
    [[ -z "$unformatted" ]] || { echo "gofmt needed: $unformatted"; return 1; }
    return
  fi
  if [[ -s Cargo.toml ]]; then cargo fmt --check; return; fi
  # Lint mode, not the default format mode, which rewrites files in place.
  if has_swift && command -v swift >/dev/null 2>&1; then swift_each swift format lint --recursive .; return; fi
  if gradle_has_task ktlintCheck; then ./gradlew ktlintCheck; return; fi
  return $NO_RUNNER
}

check_typecheck() {
  if has_npm_script typecheck; then npm run typecheck; return; fi
  if [[ -s pyproject.toml ]] && command -v uv >/dev/null 2>&1; then uv run mypy .; return; fi
  # Go, Rust, Swift, and Kotlin type-check as part of build.
  if [[ -s go.mod || -s go.work || -s Cargo.toml ]]; then return; fi
  if has_swift || is_gradle; then return; fi
  return $NO_RUNNER
}

check_test() {
  if has_npm_script test; then npm run test; return; fi
  if [[ -s pyproject.toml ]] && command -v uv >/dev/null 2>&1; then uv run pytest; return; fi
  if [[ -s go.mod || -s go.work ]]; then go test ./...; return; fi
  if [[ -s Cargo.toml ]]; then cargo test; return; fi
  if has_swift && command -v swift >/dev/null 2>&1; then swift_each swift test; return; fi
  if is_gradle && [[ -x ./gradlew ]]; then ./gradlew test; return; fi
  return $NO_RUNNER
}

check_build() {
  if has_npm_script build; then npm run build; return; fi
  if [[ -s go.mod || -s go.work ]]; then go build ./...; return; fi
  if [[ -s Cargo.toml ]]; then cargo build --locked; return; fi
  if has_swift && command -v swift >/dev/null 2>&1; then swift_each swift build; return; fi
  if is_gradle && [[ -x ./gradlew ]]; then ./gradlew build -x test; return; fi
  # An interpreted project has nothing to build.
  if [[ -s pyproject.toml ]]; then return; fi
  return $NO_RUNNER
}

run_check() {
  local name="$1" fn="$2" status=0
  "$fn" || status=$?

  case "$status" in
    0) echo "pass         $name" ;;
    "$NO_RUNNER") echo "unavailable  $name"; unavailable+=("$name") ;;
    *) echo "FAIL         $name (exit $status)"; failed+=("$name") ;;
  esac
}

run_check lint check_lint
run_check format check_format
run_check typecheck check_typecheck
run_check test check_test
run_check build check_build

echo

if (( ${#failed[@]} > 0 )); then
  echo "Failed: ${failed[*]}"
  exit 1
fi

if (( ${#unavailable[@]} > 0 )); then
  if project_detected; then
    echo "No runner for: ${unavailable[*]}"
    echo "A manifest is present, so every check is expected to run. Each one above"
    echo "reached the end of its check_<name> function without matching a language."
    echo
    echo "Two causes, and they need different fixes:"
    echo
    echo "  The language is not wired up yet. Add a branch to each check_<name>"
    echo "  function listed above, in tools/ci/ci, following the branches already"
    echo "  there. Add its toolchain to .github/actions/setup-toolchains/action.yml"
    echo "  and its tools to tools/scripts/doctor, or CI fails here instead."
    echo
    echo "  The language is wired up but its tool is missing from this machine."
    echo "  Run tools/scripts/doctor, which names the tool and how to install it."
    echo
    echo "A check with nothing to do should return 0 with a comment saying why,"
    echo "the way check_build does for Python. Returning NO_RUNNER means unwired."
    exit 1
  fi
  echo "No project manifest found, so there is nothing to check yet."
  echo "Unavailable: ${unavailable[*]}"
  echo "These become required as soon as a manifest is added."
fi
