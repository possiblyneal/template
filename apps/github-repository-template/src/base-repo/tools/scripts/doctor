#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root"

missing=0

check_required() {
  local tool="$1"

  if command -v "$tool" >/dev/null 2>&1; then
    echo "ok: $tool"
  else
    echo "missing: $tool"
    missing=1
  fi
}

check_optional() {
  local tool="$1"

  if command -v "$tool" >/dev/null 2>&1; then
    echo "ok: $tool"
  else
    echo "optional missing: $tool"
  fi
}

check_required git
check_required bash

if [[ -s package.json ]]; then
  check_required npm
fi

if [[ -s pyproject.toml ]]; then
  check_required uv
fi

if [[ -s go.work ]] || [[ -s go.mod ]]; then
  check_required go
fi

if [[ -s Cargo.toml ]]; then
  check_required cargo
fi

# SwiftPM has no workspace file, so packages sit at apps/<name>/ and libs/<name>/
# and are found by search. .build holds checked-out dependencies, each with a
# Package.swift of its own.
if [[ -n "$(find . -name Package.swift -not -path '*/.build/*' -print -quit)" ]]; then
  check_required swift
fi

# tools/ci/ci drives Gradle through ./gradlew, which needs a JDK. A missing
# wrapper leaves those checks with no runner, which fails the run because a
# manifest is present, so it is a missing tool here rather than a silent skip.
if [[ -s settings.gradle.kts || -s build.gradle.kts ]]; then
  check_required java

  if [[ -x ./gradlew ]]; then
    echo "ok: gradlew"
  else
    echo "missing: gradlew (a Gradle manifest is present but the wrapper is not executable here)"
    echo "  Generate it with: gradle wrapper"
    missing=1
  fi
fi

if find . -maxdepth 3 \( -name Dockerfile -o -name compose.yml -o -name docker-compose.yml \) | grep -q .; then
  check_optional docker
fi

# A pre-commit config does nothing until `pre-commit install` writes a hook
# into .git/hooks, which is local to each clone and never checked in. Both
# failures are silent: commits succeed as normal while the configured hooks,
# including the secret scan, never run.
if [[ -s .pre-commit-config.yaml ]]; then
  if ! command -v pre-commit >/dev/null 2>&1; then
    echo "missing: pre-commit (.pre-commit-config.yaml is present but the tool is not installed)"
    echo "  Install it, then run: pre-commit install"
    missing=1
  elif [[ ! -e .git/hooks/pre-commit ]]; then
    echo "missing: pre-commit hook (installed tool, but no hook in this clone)"
    echo "  Run: pre-commit install"
    missing=1
  else
    echo "ok: pre-commit"
  fi
fi

# The PreToolUse hook parses its input with jq. A hook that exits non-zero for
# any reason other than a deliberate block is a non-blocking error, so a missing
# jq lets writes outside the repository through without a prompt.
if [[ -x .claude/hooks/ask-outside-repo.sh ]]; then
  check_required jq
fi

if [[ "$missing" -ne 0 ]]; then
  echo "Required tools missing. Install them, then rerun tools/scripts/doctor."
  exit 1
fi

echo "Environment checks passed. Add project-specific checks to tools/scripts/doctor."
