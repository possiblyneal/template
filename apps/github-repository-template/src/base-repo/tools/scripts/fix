#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root"

# The write half of the format check in tools/ci/ci, which only reports. Same
# runners in the same order, so this repairs what that check fails on. Lint
# autofixes stay out: they rewrite code rather than whitespace, and the point of
# this script is a diff a reviewer can skim.

# Reads package.json directly. `npm run` writes its listing to stderr and prints
# nothing under --silent, so parsing its output silently matches nothing.
has_npm_script() {
  [[ -s package.json ]] &&
    command -v node >/dev/null 2>&1 &&
    command -v npm >/dev/null 2>&1 &&
    node -e 'const s=require("./package.json").scripts||{};process.exit(s[process.argv[1]]?0:1)' "$1" 2>/dev/null
}

# SwiftPM has no workspace file, so packages sit at apps/<name>/ and libs/<name>/
# and are found by search. .build holds checked-out dependencies, which carry
# Swift sources of their own and must not be rewritten.
has_swift() {
  [[ -n "$(find . -name Package.swift -not -path '*/.build/*' -print -quit)" ]]
}

# Every package runs, rather than stopping at the first failure, so one broken
# package does not leave the rest unformatted.
swift_format_each() {
  local manifest status=0
  while IFS= read -r manifest; do
    ( cd "$(dirname "$manifest")" && swift format --in-place --recursive . ) || status=1
  done < <(find . -name Package.swift -not -path '*/.build/*' -print)
  return "$status"
}

# Gradle exposes a format task only when the matching plugin is applied.
gradle_has_task() {
  [[ -s settings.gradle.kts || -s build.gradle.kts ]] && [[ -x ./gradlew ]] || return 1
  ./gradlew -q tasks --all 2>/dev/null | grep -qE "^$1( |$)"
}

if has_npm_script format; then
  npm run format
elif [[ -s pyproject.toml ]] && command -v uv >/dev/null 2>&1; then
  uv run ruff format .
elif [[ -s go.mod || -s go.work ]]; then
  gofmt -w .
elif [[ -s Cargo.toml ]]; then
  cargo fmt
elif has_swift && command -v swift >/dev/null 2>&1; then
  swift_format_each
elif gradle_has_task ktlintFormat; then
  ./gradlew ktlintFormat
else
  echo "No formatter configured. Add the one for this project to tools/scripts/fix."
  exit 0
fi

echo "Formatted. Review the diff before committing."
