# Environment / secrets
.env
.env.*
!.env.example
!.env.*.example

# Keys and credentials. A leaked key means rotation, not just a revert.
*.pem
*.key
id_rsa*
*.p12
*.pfx
credentials.json
service-account*.json
.npmrc
.pypirc

# Terraform state stores secrets in plaintext.
*.tfstate
*.tfstate.*
.terraform/

# Claude config: copied into a generated repo but not committed there.
.claude/
# Anchored: the root shim arrives via the working tree like `.claude/`
# and stays out of history. A nested CLAUDE.md is the only thing that
# loads its folder's contract, so it must be committable.
/CLAUDE.md
CLAUDE.local.md

# Local scratch
tmp/*
!tmp/.gitkeep
*.tmp
*.temp

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# Dependencies. Unanchored: these nest legitimately in monorepos.
node_modules/
.venv/
venv/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# JavaScript / TypeScript
.npm/
.pnpm-store/
.yarn/cache/
coverage/
/dist/
/build/
.next/
.nuxt/
.svelte-kit/

# Go and Rust. /bin/ is anchored: src/bin/ and cmd/*/bin/ hold real source.
/bin/
target/

# Containers
*.pid
*.cid

# Local databases
*.sqlite
*.sqlite3
*.db

# Generated artifacts
/artifacts/
/downloads/
