# Environment / secrets
.env
.env.*
!.env.example
!.env.*.example

# Keys and credentials. A leaked key means rotation, not just a revert.
*.pem
*.key
id_rsa*
*.p12
*.pfx
credentials.json
service-account*.json
.npmrc
.pypirc

# Terraform state stores secrets in plaintext.
*.tfstate
*.tfstate.*
.terraform/

# Claude worktrees are checkouts of this same repo; without this their
# entire file tree shows up as untracked noise in the main checkout.
.claude/worktrees/

# Per-machine Claude overrides. Both are personal, not part of the repo
# contract, and may hold local paths or preferences.
.claude/settings.local.json
CLAUDE.local.md

# Local scratch
tmp/*
!tmp/.gitkeep
*.tmp
*.temp
*.bak

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
.orca/

# Dependencies. Unanchored: these nest legitimately in monorepos.
node_modules/
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# JavaScript / TypeScript
.npm/
.pnpm-store/
.yarn/cache/
coverage/
/dist/
/build/
.next/
.nuxt/
.svelte-kit/

# scripts/package writes one artifact per declared target here, under the unit
# it packaged. /dist/ above is anchored to the repository root, so it does not
# reach these; without the line a packaged binary is untracked and unignored,
# and scripts/check hands every untracked file to pre-commit.
apps/*/dist/

# Go and Rust. /bin/ is anchored: src/bin/ and cmd/*/bin/ hold real source.
/bin/
target/

# Containers
*.pid
*.cid
containers/
podman/
docker-data/

# Local databases
*.sqlite
*.sqlite3
*.db

# Generated artifacts
/artifacts/
/downloads/

# Scratch space for repo-builder skill iterations, not repository content.
.claude/skills/repo-builder-workspace/
