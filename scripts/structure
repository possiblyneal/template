#!/usr/bin/env bash
set -euo pipefail

# Audit the repository's shape against the structure rules in CLAUDE.md.
#
# This checks where a file sits, and reads the contents of exactly one file --
# a unit's .unit.json, which exists because how a unit runs and what it ships
# are the two facts a tree cannot show. Three of the rules are about content
# and are reported not-applicable rather than guessed at: whether
# libs/ really holds code shared across apps, whether tests/ really spans them,
# and whether a file sits at the scope it belongs to. A script that inferred
# those from paths would be wrong quietly, which is worse than not asking.
#
# It does not source libs/detect.sh. Structure is language-independent -- the
# same reasoning that keeps adr-index out of the capability dispatch. The one
# language fact it needs is which root manifests are legal at the root, and
# those are a fixed list of filenames rather than a detection.

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

allow_file=".structure-allow"

# Folders permitted at the repository root. Everything at root is repo-wide in
# scope; anything scoped to a single app or domain belongs under that app.
# .devcontainer and gradle are here because the payload's own additions require
# them: .devcontainer is an addon, and gradle/ holds the wrapper Kotlin repos
# must commit.
root_folders=(
  .claude .devcontainer .github apps assets deploy docs gradle
  libs scripts tests tmp tools
)

# Files permitted at the repository root. The rule is that a root file needs
# permission; this list is the permission already granted, and .structure-allow
# is where a repository records the rest.
root_files=(
  # Shipped by the template payload.
  CLAUDE.md .commitlintrc.yaml .env .gitattributes .gitignore .mcp.json
  .pre-commit-config.yaml .worktreeinclude

  # Written into a repository when it is generated from the template.
  .repo-template.json

  # Git's own, and not relocatable: git reads it from the root by that name.
  .gitmodules

  # The permission this script's own rules refer to.
  .structure-allow

  # The domain model.
  CONTEXT.md CONTEXT-MAP.md

  # Additions by occasion, held back in the template's repository-addons.
  404.html AUTHORS CHANGELOG.md CITATION.cff CODEOWNERS CODE_OF_CONDUCT.md
  CONTRIBUTING.md CONTRIBUTORS.md GOVERNANCE.md LICENSE README.md SECURITY.md
  SUPPORT.md _config.yml .all-contributorsrc .env.example .nojekyll

  # Root workspace manifests, and the lockfiles their tools write beside them.
  # Swift is absent deliberately: it has no root manifest, so a Swift repository
  # keeps its packages nested and there is nothing to permit here.
  pyproject.toml uv.lock
  go.work go.work.sum
  package.json package-lock.json tsconfig.json
  Cargo.toml Cargo.lock
  build.gradle.kts gradle.properties gradlew gradlew.bat settings.gradle.kts
)

# Scoped folders: a scope holder -- the repository root, a unit, or a domain --
# may contain any of these, and each is a leaf for its own kind at any depth.
scoped_folders=(assets deploy docs libs scripts tests tools)

# The deployment technologies deploy/ recognizes. Unlike the lists above this
# one will go stale: deployment tooling turns over faster than anything else in
# a repository, so a .structure-allow entry naming another is the expected case
# here rather than the exceptional one.
deploy_folders=(compose containerfile env quadlet systemd)

# The values a unit declaration may carry. Values only: every run-and-ship
# pairing is legal, including the ones that look odd, because a rule forbidding
# a combination is a rule nobody revisits when the exception arrives. ADR 0001
# has the two cases -- a scheduled job and a library -- that broke the design
# where one word named both facts.
unit_runs='["oneshot","longlived","none"]'
unit_kinds='["executable","quadlet","none"]'
unit_targets='["linux-amd64","macos-arm64"]'

# Reads one declaration and prints one line per illegal value. In jq rather
# than in shell because hand-parsing a structured format is how
# libs/precommit.sh came to exist: a pattern that read one of three valid forms
# and reported the other two correct when they were not.
#
# Single-quoted deliberately: every \(...) below is jq's own interpolation and
# every $name is a jq argument, so shell expansion here would corrupt the
# program rather than fill it in.
# shellcheck disable=SC2016
unit_facts_program='
  [
    (if .schema_version != 1 then "schema_version \(.schema_version|tojson) is not 1" else empty end),

    (.run as $r | if ($runs | index($r)) then empty
     else "run \($r|tojson) is not one of \($runs|join(", "))" end),

    (if (.ships|type) != "object" then "ships \(.ships|tojson) is not an object naming a kind"
     else
       (.ships.kind as $k | if ($kinds | index($k)) then empty
        else "ships.kind \($k|tojson) is not one of \($kinds|join(", "))" end),

       (if .ships.kind == "executable" then
          (if (.ships.targets|type) != "array" or (.ships.targets|length) == 0
           then "ships.targets is required and non-empty when kind is executable"
           else (.ships.targets[] | . as $t | select(($targets | index($t)) | not)
                 | "ships.targets \($t|tojson) is not one of \($targets|join(", "))")
           end)
        elif (.ships|has("targets")) then
          "ships.targets is set but kind is \(.ships.kind|tojson); targets belong to executable alone"
        else empty end)
     end)
  ] | .[]
'

in_list() {
  local needle="$1" item
  shift
  for item in "$@"; do
    [[ "$needle" == "$item" ]] && return 0
  done
  return 1
}

result() {
  printf '%-18s %-16s %s\n' "$1" "$2" "$3"
}

# Violations for the check currently being run, printed under its result line.
findings=()
status=0

record() {
  findings+=("$1")
}

verdict() {
  if (( ${#findings[@]} == 0 )); then
    result "$1" pass "$2"
  else
    result "$1" FAIL "${#findings[@]} violation(s)"
    printf '                     %s\n' "${findings[@]}"
    status=1
  fi
  findings=()
}

# .gitkeep is how an otherwise empty directory exists in Git at all, so it is
# exempt from every rule that judges a file by its name. It still counts as a
# path for the rules that read the directories above it -- holding a folder
# open is the entire reason the file is there.
is_placeholder() {
  [[ "${1##*/}" == .gitkeep ]]
}

# Splits a path into the global `parts` array. Not a read into an array with
# IFS set to a slash, which stops at the first newline: a newline is legal in a
# path, and read would silently drop every segment after it rather than
# misreporting one.
#
# It also sets `src_limit`, the index of the first src segment, or the segment
# count when there is none. Everything below a src/ is the language's business
# rather than this repository's layout -- a Go package named docs/, a Python
# scripts/ module, a generated tree with a shape nobody chose -- so the rules
# that apply at depth apply to the tree around the source and stop there.
split_path() {
  local rest="$1" i
  parts=()
  while [[ "$rest" == */* ]]; do
    parts+=("${rest%%/*}")
    rest="${rest#*/}"
  done
  parts+=("$rest")

  src_limit=${#parts[@]}
  for (( i = 0; i < ${#parts[@]}; i++ )); do
    if [[ "${parts[i]}" == src ]]; then
      src_limit=$i
      break
    fi
  done

  # And `scope_start`, the first segment a depth rule may judge. The scope
  # holders are the root, a unit, and a domain; `apps/` is none of them, so the
  # segment under it is a unit name and cannot be a scoped folder however it is
  # spelled. Without this a unit named docs, tests, scripts, or deploy collects
  # findings for its name -- including `apps/docs/src/: src belongs to a scope
  # holder, not under docs/`, which is wrong twice over, since apps/docs/ is
  # exactly the scope holder that src belongs to.
  scope_start=0
  if [[ "${parts[0]}" == apps ]]; then
    scope_start=2
  fi
}

# The path down to and including parts[$2], for naming the directory a finding
# is about rather than the file that happened to reveal it.
path_prefix() {
  local -n _parts="$1"
  local upto="$2" prefix="" i
  for (( i = 0; i <= upto; i++ )); do prefix="$prefix/${_parts[i]}"; done
  printf '%s' "${prefix#/}"
}

if ! git rev-parse --git-dir > /dev/null 2>&1; then
  result structure unavailable "not a Git repository; the audit enumerates with git ls-files"
  exit 1
fi

# Enumerate through Git rather than the filesystem. Gitignored scratch --
# .orca/, node_modules/, a virtualenv, whatever a machine leaves lying around --
# is then invisible by construction rather than by a prune list that drifts out
# of date the way this repository's clean script once did.
# A path in conflict is listed once per merge stage, and git orders the index
# by path so those entries are adjacent. Without this, every finding about a
# conflicted file is reported three times.
tracked=()
previous=""
while IFS= read -r -d '' path; do
  [[ "$path" == "$previous" ]] && continue
  previous="$path"
  tracked+=("$path")
done < <(git ls-files -z)

if (( ${#tracked[@]} == 0 )); then
  result structure not-applicable "no tracked files"
  exit 0
fi

# .structure-allow records the permission the rules say a non-standard path
# needs. A bare path allows exactly that file. A path ending in / names a
# prefix the walk stops descending into, which is how a vendored dependency or
# a tracked test fixture keeps its own shape without the rules growing an
# "unless it is a fixture" clause that would hollow them out.
allow_paths=()
allow_prefixes=()
if [[ -f "$allow_file" ]]; then
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line#"${line%%[![:space:]]*}"}"
    # A whole-line comment, then a trailing one -- which must be preceded by
    # whitespace, since # is a legal character in a filename and stripping it
    # unconditionally voids the permission the line was written to grant.
    [[ "$line" == \#* ]] && continue
    line="${line%%[[:space:]]#*}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -n "$line" ]] || continue
    if [[ "$line" == */ ]]; then
      allow_prefixes+=("$line")
    else
      allow_paths+=("$line")
    fi
  done < "$allow_file"
fi

paths=()
pruned=0
for path in "${tracked[@]}"; do
  skip=""
  for prefix in ${allow_prefixes[@]+"${allow_prefixes[@]}"}; do
    [[ "$path" == "$prefix"* ]] && { skip=1; break; }
  done
  if [[ -n "$skip" ]]; then
    pruned=$((pruned + 1))
    continue
  fi
  paths+=("$path")
done

echo "structure"
echo

# --- root -------------------------------------------------------------------

for path in "${paths[@]}"; do
  [[ "$path" == */* ]] && continue
  is_placeholder "$path" && continue
  in_list "$path" "${root_files[@]}" && continue
  in_list "$path" ${allow_paths[@]+"${allow_paths[@]}"} && continue
  record "$path: root file needs permission; move it, or add it to $allow_file"
done
verdict root-files "every root file is permitted"

seen_roots=""
for path in "${paths[@]}"; do
  [[ "$path" == */* ]] || continue
  top="${path%%/*}"
  [[ " $seen_roots " == *" $top "* ]] && continue
  seen_roots="$seen_roots $top"
  in_list "$top" "${root_folders[@]}" && continue
  in_list "$top" ${allow_paths[@]+"${allow_paths[@]}"} && continue
  record "$top/: root folder needs permission; everything at root is repo-wide"
done
verdict root-folders "every root folder is permitted"

# --- apps -------------------------------------------------------------------

# A unit is a folder under apps/. A domain is a folder under a unit that is
# neither src/ nor a scoped folder, so the two are told apart by what a folder
# is not rather than by a marker file a repository would have to remember to
# write.
units=()
declared=()
domains=()
unit_src=()
apps_src=""
for path in "${paths[@]}"; do
  [[ "$path" == apps/* ]] || continue
  split_path "$path"

  if [[ "${parts[1]}" == src ]]; then
    if [[ -z "$apps_src" ]]; then
      apps_src=1
      record "apps/src/: source belongs to a unit, never directly under apps/"
    fi
    continue
  fi

  unit="${parts[1]}"
  # A unit is a folder under apps/, so a file sitting directly there belongs to
  # no unit and is not deployable by itself.
  if (( ${#parts[@]} < 3 )); then
    is_placeholder "$path" || record "$path: apps/ holds units, which are folders; a file here belongs to none"
    continue
  fi
  in_list "$unit" ${units[@]+"${units[@]}"} || units+=("$unit")

  child="${parts[2]}"
  # A unit declares at its own root. One deeper is a domain's or a scoped
  # folder's file, and domains do not declare -- the unit is what ships.
  if (( ${#parts[@]} == 3 )) && [[ "$child" == .unit.json ]]; then
    declared+=("$unit")
  fi
  # A file directly under the unit is not a domain and not a src placement.
  (( ${#parts[@]} >= 4 )) || continue

  if [[ "$child" == src ]]; then
    in_list "$unit" ${unit_src[@]+"${unit_src[@]}"} || unit_src+=("$unit")
  elif ! in_list "$child" "${scoped_folders[@]}"; then
    in_list "$unit/$child" ${domains[@]+"${domains[@]}"} || domains+=("$unit/$child")
  fi
done

for unit in ${units[@]+"${units[@]}"}; do
  in_list "$unit" ${unit_src[@]+"${unit_src[@]}"} || continue
  for domain in ${domains[@]+"${domains[@]}"}; do
    if [[ "$domain" == "$unit/"* ]]; then
      record "apps/$unit/: a unit split into domains has no src/ of its own; ${domain##*/}/ is a domain"
      break
    fi
  done
done
verdict apps-layout "units and domains hold src/ where the rules place it"

# --- unit declarations ------------------------------------------------------

# How a unit runs and what it ships are not on disk: a Go module with one main
# package is a CLI, a TUI, or a service, and the compiler cannot tell them
# apart. So a unit declares, and this is where the declaration is required --
# at commit time with the unit named, rather than at release time with an
# empty asset list.
if (( ${#units[@]} == 0 )); then
  result unit-declaration not-applicable "no units under apps/"
else
  for unit in "${units[@]}"; do
    in_list "$unit" ${declared[@]+"${declared[@]}"} && continue
    record "apps/$unit/: no .unit.json; a unit declares how it runs and what it ships"
  done
  verdict unit-declaration "every unit carries a declaration"
fi

if (( ${#declared[@]} == 0 )); then
  result unit-facts not-applicable "no declaration to read"
elif ! command -v jq > /dev/null 2>&1; then
  # A check that did not run is not a check that passed, so this is unavailable
  # and fails the run rather than reporting a silent pass over unread files.
  result unit-facts unavailable "jq is needed to read a unit declaration"
  status=1
else
  for unit in "${declared[@]}"; do
    file="apps/$unit/.unit.json"
    if ! problems="$(jq -r \
      --argjson runs "$unit_runs" \
      --argjson kinds "$unit_kinds" \
      --argjson targets "$unit_targets" \
      "$unit_facts_program" "$file" 2> /dev/null)"; then
      record "$file: not readable as JSON"
      continue
    fi
    while IFS= read -r problem; do
      [[ -n "$problem" ]] && record "$file: $problem"
    done <<< "$problems"
  done
  verdict unit-facts "every declared fact is a value the template recognizes"
fi

# --- src placement ----------------------------------------------------------

for path in "${paths[@]}"; do
  split_path "$path"
  scope=""
  for (( i = scope_start; i < ${#parts[@]} - 1; i++ )); do
    # The first src ends the walk either way: a src nested inside another src
    # is the source tree's own arrangement, not a placement this rule judges.
    if [[ "${parts[i]}" == src ]]; then
      if [[ -n "$scope" ]]; then
        finding="$(path_prefix parts "$i")/: src belongs to a scope holder, not under $scope/"
        [[ " ${findings[*]-} " == *" $finding "* ]] || record "$finding"
      fi
      break
    fi
    in_list "${parts[i]}" "${scoped_folders[@]}" && scope="${parts[i]}"
  done
done
verdict src-placement "no src/ sits under a scoped folder"

# --- leaf rule --------------------------------------------------------------

for path in "${paths[@]}"; do
  split_path "$path"
  for kind in "${scoped_folders[@]}"; do
    count=0
    for (( i = scope_start; i < ${#parts[@]} - 1 && i < src_limit; i++ )); do
      [[ "${parts[i]}" == "$kind" ]] && count=$((count + 1))
    done
    if (( count >= 2 )); then
      finding="$path: $kind/ contains another $kind/; a scoped folder is a leaf for its own kind"
      [[ " ${findings[*]-} " == *" $finding "* ]] || record "$finding"
    fi
  done
done
verdict leaf-rule "no scoped folder contains another of its own kind"

# --- deploy vocabulary ------------------------------------------------------

for path in "${paths[@]}"; do
  split_path "$path"
  for (( i = scope_start; i < ${#parts[@]} - 1 && i < src_limit; i++ )); do
    [[ "${parts[i]}" == deploy ]] || continue
    child="${parts[i+1]}"
    # Whether the child is a folder at all is decided before its name is, so a
    # file that happens to be called env or quadlet is still a loose file.
    if (( i + 1 == ${#parts[@]} - 1 )); then
      is_placeholder "$path" && continue
      finding="$path: deploy/ holds one folder per technology (${deploy_folders[*]}), not loose files"
    else
      in_list "$child" "${deploy_folders[@]}" && continue
      finding="$(path_prefix parts "$(( i + 1 ))")/: not a recognized deployment technology (${deploy_folders[*]})"
    fi
    [[ " ${findings[*]-} " == *" $finding "* ]] || record "$finding"
  done
done
verdict deploy-folders "every deploy/ subfolder is a recognized technology"

# --- docs content -----------------------------------------------------------

for path in "${paths[@]}"; do
  split_path "$path"
  under_docs=""
  for (( i = scope_start; i < ${#parts[@]} - 1 && i < src_limit; i++ )); do
    [[ "${parts[i]}" == docs ]] && { under_docs=1; break; }
  done
  [[ -n "$under_docs" ]] || continue
  name="${parts[-1]}"
  [[ "$name" == *.md ]] && continue
  is_placeholder "$path" && continue
  in_list "$path" ${allow_paths[@]+"${allow_paths[@]}"} && continue
  record "$path: docs/ takes Markdown freely; anything else needs permission"
done
verdict docs-content "docs/ holds Markdown only"

# --- what this cannot answer ------------------------------------------------

echo
result libs-are-shared not-applicable "whether libs/ is shared across apps is a judgment about content"
result tests-are-crossapp not-applicable "whether tests/ spans apps is a judgment about content"
result scope-matching not-applicable "whether a file sits at its own scope is a judgment about content"

echo
if (( pruned > 0 )); then
  echo "$pruned path(s) not descended into, per $allow_file."
fi
if (( status == 0 )); then
  echo "Structure matches the rules in CLAUDE.md."
else
  echo "Structure does not match the rules in CLAUDE.md."
fi
exit "$status"
