#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

# An explicit argument wins over GITHUB_REF_NAME so a workflow_dispatch run,
# where the ref is a branch rather than the tag being released, can pass the
# tag directly.
tag="${1:-${GITHUB_REF_NAME:-}}"

if [[ -z "$tag" ]]; then
  echo "No release tag detected. Pass tag as first argument when running locally."
  echo "Example: scripts/release v1.2.3"
  exit 1
fi

case "$tag" in
  v[0-9]*.[0-9]*.[0-9]*) ;;
  *)
    echo "Release tag should look like v1.2.3. Got: $tag"
    exit 1
    ;;
esac

version="${tag#v}"

echo "Preparing release for $tag"

# A changelog is an addition by occasion, so a project may not have reached it
# yet. Both cases release; only the source of the notes differs, and the choice
# is announced so a missing changelog is never mistaken for an empty one.
notes_args=()

if [[ -f CHANGELOG.md ]]; then
  # The release body is the changelog section for this version rather than notes
  # generated from the commits since the last tag. Extracting it keeps the file
  # canonical: one edit produces both, so the tree and the releases page cannot
  # disagree. Dots are escaped because awk matches the pattern as a regex.
  notes="$(awk -v version="${version//./\\.}" '
    $0 ~ "^## \\[" version "\\]" { collecting = 1; next }
    collecting && /^## / { exit }
    collecting && !seen && /^[[:space:]]*$/ { next }
    collecting { seen = 1; print }
  ' CHANGELOG.md)"

  # Refusing here is the point of keeping a changelog: the file is the record,
  # so a version absent from it has not been cut yet whatever the tag says.
  if [[ -z "$notes" ]]; then
    echo "CHANGELOG.md has no entries under ## [$version], so $tag would publish empty notes."
    echo "Retitle the Unreleased section as ## [$version] - $(date +%F) before tagging."
    exit 1
  fi

  echo "Notes: the ## [$version] section of CHANGELOG.md."
  notes_args=(--notes "$notes")
else
  echo "Notes: generated by GitHub, since this project keeps no CHANGELOG.md."
  notes_args=(--generate-notes)
fi

if [[ ! -x scripts/ci ]]; then
  echo "scripts/ci is missing or not executable, so this release would ship unverified."
  exit 1
fi

scripts/ci

# Every unit is packaged before the tag is cut, so a build that cannot be made
# fails the release with nothing published rather than leaving a tag pointing at
# a release with no assets. Each unit decides what packaging means from its own
# declaration: a unit shipping nothing prints that and produces no file, and a
# unit shipping a quadlet is validated and produces no file either, so the walk
# needs to know nothing about the kinds.
shopt -s nullglob

artifacts=()
for unit_dir in apps/*/; do
  [[ -d "$unit_dir" ]] || continue
  unit="$(basename "$unit_dir")"
  scripts/package "$unit"

  produced=("$unit_dir"dist/*)
  # Packaging exits 0 in cases that produce nothing and are not failures on
  # their own: every declared target unreachable from this host, or a language
  # with no packaging adapter wired. Neither is a failure of the unit, but both
  # are a failure of the release, which is the one place the declaration has to
  # be honoured -- the tag would otherwise be cut with the asset list silently
  # short, which is the thing this walk exists to prevent.
  if (( ${#produced[@]} == 0 )) &&
    [[ "$(jq -r '.ships.kind' "$unit_dir.unit.json")" == executable ]]; then
    echo "apps/$unit declares ships: executable and packaging produced no file." >&2
    echo "The lines scripts/package printed say which target could not be reached." >&2
    exit 1
  fi

  for artifact in "${produced[@]}"; do
    [[ -f "$artifact" ]] && artifacts+=("$artifact")
  done
done

if (( ${#artifacts[@]} > 0 )); then
  echo "Artifacts: ${artifacts[*]}"
else
  # A repository where nothing ships an artifact still cuts a release: the tag
  # and the notes are the release, and an empty asset list is an outcome rather
  # than a half-finished job.
  echo "Artifacts: none, since no unit here ships one."
fi

gh release create "$tag" --title "$tag" "${notes_args[@]}" "${artifacts[@]}"
