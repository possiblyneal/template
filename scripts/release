#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

# An explicit argument wins over GITHUB_REF_NAME so a workflow_dispatch run,
# where the ref is a branch rather than the tag being released, can pass the
# tag directly.
tag="${1:-${GITHUB_REF_NAME:-}}"

if [[ -z "$tag" ]]; then
  echo "No release tag detected. Pass tag as first argument when running locally."
  echo "Example: scripts/release v1.2.3"
  exit 1
fi

case "$tag" in
  v[0-9]*.[0-9]*.[0-9]*) ;;
  *)
    echo "Release tag should look like v1.2.3. Got: $tag"
    exit 1
    ;;
esac

version="${tag#v}"

echo "Preparing release for $tag"

if [[ ! -f CHANGELOG.md ]]; then
  echo "CHANGELOG.md is missing, so this release has no notes to publish."
  exit 1
fi

# The release body is the changelog section for this version rather than notes
# generated from the commits since the last tag. Extracting it keeps the file
# canonical: one edit produces both, so the tree and the releases page cannot
# disagree. Dots are escaped because awk matches the pattern as a regex.
notes="$(awk -v version="${version//./\\.}" '
  $0 ~ "^## \\[" version "\\]" { collecting = 1; next }
  collecting && /^## / { exit }
  collecting && !seen && /^[[:space:]]*$/ { next }
  collecting { seen = 1; print }
' CHANGELOG.md)"

if [[ -z "$notes" ]]; then
  echo "CHANGELOG.md has no entries under ## [$version], so $tag would publish empty notes."
  echo "Retitle the Unreleased section as ## [$version] - $(date +%F) before tagging."
  exit 1
fi

if [[ ! -x scripts/ci ]]; then
  echo "scripts/ci is missing or not executable, so this release would ship unverified."
  exit 1
fi

scripts/ci

if ! command -v gh >/dev/null 2>&1; then
  echo "gh is not installed, so there is no way to publish $tag."
  exit 1
fi

# Artifacts are project-specific, so the template builds none. Build them above
# this line and pass the files as trailing arguments here; the tag and the notes
# are already right without them, so a release with no artifact is still a real
# release rather than a half-finished one.
gh release create "$tag" --title "$tag" --notes "$notes"
