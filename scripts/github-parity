#!/usr/bin/env bash
set -euo pipefail

# Refuse to let the two .github/ trees diverge. A repository that ships a
# template payload holds its own configuration at .github/ and the copy every
# generated repository is cut from at
# apps/github-repository-template/src/base-repo/.github/, and the two are
# byte-identical by discipline rather than by mechanism.
#
# Dependabot is what ends that discipline. Its github-actions ecosystem reaches
# root only -- the reference requires directory / to find workflow files -- so
# a bump lands on the root copy and leaves the payload pinned to the old SHA,
# through a pull request that looks routine. This does not update anything: it
# fails until the bump is mirrored, which turns each root bump into a complete
# one. A hand edit to one tree fails the same way.
#
# Not folded into scripts/structure, which audits where a file sits. This is a
# question about content equality between two trees.
#
# A repository with no payload has one .github/ and nothing to compare it
# against, which is not-applicable rather than a pass -- and it is the state
# most repositories carrying this script are in. It is shipped to them anyway
# because a generated repository that later grows a payload of its own is not
# hypothetical: this repository is one, generated from the payload it now
# holds.

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

# shellcheck source-path=SCRIPTDIR
# shellcheck source=libs/result.sh
source "$repo_root/scripts/libs/result.sh"

root=".github"
payload="apps/github-repository-template/src/base-repo/.github"
record=".repo-template.json"

# Content that differs deliberately, by named path rather than by pattern, so a
# second divergence cannot join it silently. Presence is still checked: the
# exception says the two copies may differ, not that either may be missing.
#
# dependabot.yml is the one. The payload ships no pyproject.toml, so its copy
# must not carry the root's pip entry -- an ecosystem naming a manifest that is
# not there fails the run rather than being skipped.
content_exceptions=(dependabot.yml)

# A payload file the root deliberately dropped. The record is
# .repo-template.json's generation.features, where the resolution is already
# written down; this table maps a feature name to the path its omission
# accounts for. Only a feature naming a file appears here -- features records
# deliberate absences of settings too, and those have no path.
feature_path() {
  case "$1" in
    codeql) echo "workflows/codeql.yml" ;;
    *) return 1 ;;
  esac
}

in_list() {
  local needle="$1" item
  shift
  for item in "$@"; do
    [[ "$item" == "$needle" ]] && return 0
  done
  return 1
}

# The paths under each tree, relative to that tree, from the Git index rather
# than the filesystem: a workflow added and staged is the case this check is
# for, and an untracked scratch file in either tree is not.
tree_paths() {
  git ls-files "$1" 2>/dev/null | sed "s|^$1/||"
}

if ! command -v git > /dev/null 2>&1; then
  result github-parity unavailable "git is required to enumerate the two trees"
  tally
  exit
fi

root_paths="$(tree_paths "$root")"
payload_paths="$(tree_paths "$payload")"

if [[ -z "$payload_paths" ]]; then
  result github-parity not-applicable "no template payload at $payload"
  tally
  exit
fi

# Which deliberate omissions the record accounts for, resolved once. Only a
# payload file the root lacks needs this, so a host without jq is told the
# check could not be made rather than failed on a question it could not ask.
omitted=""
if [[ "$root_paths" != "$payload_paths" && -f "$record" ]]; then
  if ! command -v jq > /dev/null 2>&1; then
    result github-parity unavailable "jq is required to read generation.features in $record"
    tally
    exit
  fi
  while IFS= read -r feature; do
    path="$(feature_path "$feature")" || continue
    omitted+="$path"$'\n'
  done < <(jq -r '.generation.features // {} | to_entries[] | select(.value == "omitted-by-choice") | .key' "$record")
fi

# Membership is decided against the enumerated lists rather than the
# filesystem, so the answer comes from where the paths did. A commit staging a
# deletion has the file still on disk and already out of the index, and the
# index is the tree being committed.
holds() {
  [[ $'\n'"$1"$'\n' == *$'\n'"$2"$'\n'* ]]
}

while IFS= read -r path; do
  [[ -n "$path" ]] || continue

  if ! holds "$payload_paths" "$path"; then
    record "$path is in $root and not in the payload; add it to $payload/"
  elif ! holds "$root_paths" "$path"; then
    holds "$omitted" "$path" ||
      record "$path is in the payload and not in $root; mirror it, or record the omission under generation.features in $record"
  elif ! in_list "$path" "${content_exceptions[@]}" && ! cmp -s "$root/$path" "$payload/$path"; then
    record "$path differs between the two trees; mirror the change into the other"
  fi
done < <(printf '%s\n%s\n' "$root_paths" "$payload_paths" | sort -u)

verdict github-parity "the two .github/ trees agree"

if tally; then
  echo "The root and payload .github/ trees agree."
else
  echo "The root and payload .github/ trees have diverged; each finding above names the fix."
  exit 1
fi
