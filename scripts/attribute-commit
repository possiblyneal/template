#!/usr/bin/env bash
set -euo pipefail

# Write the commit's Generated-By trailer at prepare-commit-msg, before
# commitlint reads the message.
#
# A tool is not a co-author, but the model is worth keeping: it is the only
# per-commit record of what produced the change. The model comes from outside
# this repository, from an agent-side hook, by one of two routes. CLAUDE_COMMIT_MODEL
# is the session's model ID exported into a git command. Claude Code ignores an
# environment rewritten by a hook that grants no permission
# (anthropics/claude-code#32060), so the hook also writes the ID, whenever a Bash
# command contains git, to ${XDG_CACHE_HOME:-~/.cache}/claude-commit-model/<id>,
# named by CLAUDE_CODE_SESSION_ID, which Claude Code sets in every Bash command.
# The variable wins when both exist. When the message has no Generated-By
# trailer, this inserts one from whichever it finds. With neither the author
# writes the trailer. An --amend run by an agent is
# stamped like any other commit, making the agent its author of record.
#
# A Co-Authored-By addressed to noreply@anthropic.com is rewritten first, from
# habit or with Claude Code's git instructions on, and the address dropped: it
# exists so GitHub can attribute a Co-Authored-By to an account, which does not
# apply to a Generated-By naming a model. A human co-author keeps their line.
#
# Without a model from either source nothing is inserted. A commit made outside Claude
# Code carries no trailer unless its author writes one, and `trailer-exists` in
# .commitlintrc.yaml refuses it: a script that supplied the trailer
# unconditionally would leave that rule reporting a record nothing made.
#
# Nor is anything inserted while a rebase or cherry-pick replays commits: git
# runs this hook for each one, and stamping them would name the session's model
# on commits it did not write.
#
# An empty message gains the trailer like any other, so git does not abort it;
# commitlint refuses it instead, since its header is then the trailer line and
# has no conventional type. The hook runs before the editor opens and cannot
# tell an empty message from one about to be written.
#
# pre-commit passes the message file as the first argument at this stage. The
# other two arguments Git supplies -- the source and the commit object -- are
# not read: the in-progress state above is what tells a replay apart.

msg_file="${1:-}"
[[ -n "$msg_file" && -f "$msg_file" ]] || exit 0

sed -i -E \
  's/^[Cc]o-[Aa]uthored-[Bb]y:[[:space:]]*(.+)[[:space:]]+<noreply@anthropic\.com>[[:space:]]*$/Generated-By: \1/' \
  "$msg_file"

replaying() {
  local path
  for path in rebase-merge rebase-apply CHERRY_PICK_HEAD; do
    [[ -e "$(git rev-parse --git-path "$path" 2>/dev/null)" ]] && return 0
  done
  return 1
}

# Asks what `trailer-exists` will see: commitlint runs this same parse and
# matches the key case-sensitively, so a Generated-By line in the body, or one
# spelled in lowercase, does not count.
attributed() {
  git interpret-trailers --parse "$msg_file" | grep -q '^Generated-By:'
}

# --if-exists add, because git compares keys case-insensitively and would
# otherwise treat a lowercase trailer as this one and skip it. --no-divider
# keeps a `---` body line from pulling the trailer up mid-message; commitlint,
# whose parse stops at that line, then refuses the commit rather than
# accepting a trailer buried in the body.
#
# The session ID is joined into a path, so only a plain ID is read; anything
# with a slash or dot could climb out of the cache directory.
model="${CLAUDE_COMMIT_MODEL:-}"
session_file="${XDG_CACHE_HOME:-$HOME/.cache}/claude-commit-model/${CLAUDE_CODE_SESSION_ID:-}"
if [[ -z "$model" && "${CLAUDE_CODE_SESSION_ID:-}" =~ ^[A-Za-z0-9-]+$ && -f "$session_file" ]]; then
  IFS= read -r model < "$session_file" || true
fi

if [[ -n "$model" ]] && ! attributed && ! replaying; then
  git interpret-trailers --in-place --no-divider --if-exists add \
    --trailer "Generated-By: $model" "$msg_file"
fi
