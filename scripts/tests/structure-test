#!/usr/bin/env bash
set -uo pipefail

# Exercises where a file sits, which is all scripts/structure judges. The three
# rules it reports not-applicable -- whether libs/ is shared, whether tests/
# spans apps, whether a file sits at its own scope -- have no fixture here
# because they have no mechanical answer to assert.
#
# Each fixture is a real Git repository with the script copied into it, rather
# than the script run against a directory from outside. scripts/structure
# resolves its own repository root from BASH_SOURCE and cds there, so running
# the template's copy against a fixture would audit the template instead. The
# copy is also what a generated repository actually has.

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

# shellcheck source-path=SCRIPTDIR
# shellcheck source=libs/harness.sh
source "$repo_root/scripts/tests/libs/harness.sh"

# A repository holding nothing but the script under test, staged so that
# git ls-files can see it. No commit: the index is what the script enumerates,
# and committing would need an identity the harness has deliberately isolated
# the fixture from.
fixture() {
  cleanup
  current="$1"
  work="$(mktemp -d)"
  git -C "$work" init -q
  mkdir -p "$work/scripts"
  cp "$repo_root/scripts/structure" "$work/scripts/structure"
}

# Stages every path written since the fixture was created, then audits.
audit() {
  git -C "$work" add -A > /dev/null 2>&1
  (cd "$work" && ./scripts/structure) > "$work/.audit-output" 2>&1
}

write() {
  mkdir -p "$work/$(dirname "$1")"
  printf '%s\n' "${2-x}" > "$work/$1"
}

assert_passes() {
  if audit; then
    pass
  else
    fail "compliant tree was rejected: $(grep -E '^ +' "$work/.audit-output" | head -1 | xargs)"
  fi
}

# Asserts the audit fails and that the named check is the only one reporting
# it, so a fixture cannot pass this suite by tripping a rule other than the one
# it means to, nor by tripping that rule alongside an unnoticed second.
assert_fails() {
  local failing
  if audit; then
    fail "violation was accepted"
  elif ! grep -qE "^$1 +FAIL" "$work/.audit-output"; then
    fail "expected $1 to fail; got: $(grep -E 'FAIL' "$work/.audit-output" | head -1 | xargs)"
  elif (( $(grep -cE '^[a-z-]+ +FAIL' "$work/.audit-output") != 1 )); then
    failing="$(grep -oE '^[a-z-]+ +FAIL' "$work/.audit-output" | awk '{print $1}' | paste -sd,)"
    fail "expected only $1 to fail; also failing: $failing"
  else
    pass
  fi
}

trap cleanup EXIT

echo "structure-test"

fixture "a minimal compliant repository passes"
write CLAUDE.md
write apps/billing/src/main.py
write docs/adrs/0001-a-decision.md
assert_passes

fixture "a root manifest and its lockfile are permitted"
write pyproject.toml
write uv.lock
write apps/billing/src/main.py
assert_passes

fixture "an unpermitted root file fails"
write NOTES.txt
assert_fails root-files

fixture "an unpermitted root folder fails"
write vendor/thing/x.go
assert_fails root-folders

fixture "an addon root file is permitted"
write README.md
write LICENSE
write CHANGELOG.md
assert_passes

fixture "source directly under apps fails"
write apps/src/main.py
assert_fails apps-layout

fixture "a unit with domains keeps no src of its own"
write apps/billing/src/main.py
write apps/billing/invoicing/src/main.py
assert_fails apps-layout

fixture "a unit with domains puts src under each domain"
write apps/billing/invoicing/src/main.py
write apps/billing/dunning/src/main.py
write apps/billing/docs/specs/a-contract.md
assert_passes

fixture "a unit without domains puts src under itself"
write apps/billing/src/main.py
write apps/billing/tests/a-test.py
write apps/billing/scripts/deploy
assert_passes

fixture "a scoped folder beside src is not a domain"
write apps/billing/src/main.py
write apps/billing/libs/shared.py
write apps/billing/assets/logo.svg
write apps/billing/deploy/quadlet/billing.container
assert_passes

fixture "src under a scoped folder fails"
write tests/src/helper.py
assert_fails src-placement

fixture "a scoped folder inside its own kind fails"
write libs/auth/libs/token.py
assert_fails leaf-rule

fixture "the leaf rule reaches any depth"
write scripts/one/two/three/scripts/thing
assert_fails leaf-rule

fixture "different kinds nest freely"
write scripts/tests/libs/harness.sh
write tests/libs/fixtures.py
assert_passes

fixture "an unrecognized deploy technology fails"
write deploy/nomad/job.hcl
assert_fails deploy-folders

fixture "every recognized deploy technology passes"
write deploy/quadlet/app.container
write deploy/containerfile/Containerfile
write deploy/compose/compose.yaml
write deploy/systemd/app.service
write deploy/env/production.env
assert_passes

fixture "a loose file directly under deploy fails"
write deploy/README.md
assert_fails deploy-folders

fixture "gitkeep holds an empty deploy open"
write deploy/.gitkeep ""
assert_passes

# A file is judged a file before its name is looked at, so one named after a
# technology is still a loose file rather than the folder it is imitating.
fixture "a loose deploy file named after a technology still fails"
write deploy/env
write deploy/quadlet
assert_fails deploy-folders

# The sets the apps check accumulates are arrays, not space-joined strings: a
# directory named * would otherwise glob and one holding a space would split,
# and either way the violation is lost rather than reported.
fixture "a unit whose name would glob is still checked"
write 'apps/*/src/main.py'
write 'apps/*/billing/src/main.py'
assert_fails apps-layout

# assert_fails alone would pass here against the pre-fix script too, which
# reported the same violation under the garbled name apps/app/. The name is
# what the fix is about, so the name is what this asserts.
fixture "a unit whose name holds a space is reported under that name"
write 'apps/my app/src/main.py'
write 'apps/my app/billing/src/main.py'
audit || true
if grep -q 'apps/my app/' "$work/.audit-output"; then
  pass
else
  fail "expected the unit name to survive: $(grep -E 'FAIL' "$work/.audit-output" | head -1 | xargs)"
fi

fixture "a submodule keeps its .gitmodules at the root"
write .gitmodules
assert_passes

fixture "a file directly under apps belongs to no unit"
write apps/README.md
assert_fails apps-layout

fixture "gitkeep is exempt at the root"
write .gitkeep ""
assert_passes

# Everything below a src/ is the language's arrangement, not this repository's.
fixture "a docs folder inside src is the source tree's own"
write apps/api/src/internal/docs/swagger.json
assert_passes

fixture "the leaf rule stops at src"
write apps/api/src/gen/scripts/inner/scripts/run.py
assert_passes

fixture "a deploy folder inside src is not a deployment folder"
write apps/api/src/deploy/nomad/job.hcl
assert_passes

fixture "a src nested inside src is not a placement violation"
write apps/api/src/vendor/tests/src/x.py
assert_passes

fixture "the rules still apply to the tree around the source"
write apps/api/docs/swagger.json
assert_fails docs-content

# apps/ is not a scope holder, so the segment under it is a unit name and can
# never be a scoped folder however it is spelled.
fixture "a unit may be named docs"
write apps/docs/src/main.py
assert_passes

fixture "a unit may be named tests"
write apps/tests/tests/a.py
assert_passes

fixture "a unit may be named scripts"
write apps/scripts/scripts/build.sh
assert_passes

fixture "a unit may be named deploy"
write apps/deploy/src/main.py
assert_passes

fixture "a unit named docs still holds its own docs to the docs rule"
write apps/docs/docs/notes.yaml
assert_fails docs-content

fixture "a unit named tests still holds its own tests to the leaf rule"
write apps/tests/tests/inner/tests/a.py
assert_fails leaf-rule

fixture "a docs folder under a unit is still a scope holder"
write apps/api/docs/src/notes.md
assert_fails src-placement

fixture "a non-Markdown file under docs fails"
write docs/specs/openapi.yaml
assert_fails docs-content

fixture "the docs rule reaches a scoped docs folder"
write apps/billing/src/main.py
write apps/billing/docs/specs/openapi.yaml
assert_fails docs-content

fixture "gitkeep is exempt under docs"
write docs/plans/.gitkeep ""
write docs/specs/.gitkeep ""
assert_passes

# A path is not a comment. Stripping from a bare # would void the permission
# this very line grants.
fixture "structure-allow permits a path containing a hash"
write 'C#Notes.txt'
write .structure-allow 'C#Notes.txt'
assert_passes

fixture "structure-allow still honors a trailing comment"
write NOTES.txt
write .structure-allow 'NOTES.txt  # explained in docs/'
assert_passes

fixture "structure-allow permits a named root file"
write NOTES.txt
write .structure-allow 'NOTES.txt'
assert_passes

fixture "structure-allow permits a named docs file"
write docs/specs/openapi.yaml
write .structure-allow 'docs/specs/openapi.yaml'
assert_passes

fixture "a structure-allow prefix stops the walk descending"
write tests/fixtures/mirror/tests/a-test.py
write .structure-allow 'tests/fixtures/'
assert_passes

fixture "a structure-allow prefix reports what it skipped"
write tests/fixtures/mirror/tests/a-test.py
write .structure-allow 'tests/fixtures/'
audit
if grep -q 'not descended into' "$work/.audit-output"; then
  pass
else
  fail "pruned paths were not reported"
fi

fixture "comments and blank lines in structure-allow are ignored"
write NOTES.txt
write .structure-allow '# a reason this file is here

NOTES.txt
'
assert_passes

fixture "every violation is reported, not just the first"
write NOTES.txt
write ALSO.txt
audit
if grep -q '2 violation(s)' "$work/.audit-output"; then
  pass
else
  fail "expected both root files reported"
fi

cleanup
current="a directory that is not a Git repository is unavailable"
work="$(mktemp -d)"
mkdir -p "$work/scripts"
cp "$repo_root/scripts/structure" "$work/scripts/structure"
output="$( (cd "$work" && ./scripts/structure) 2>&1 )"
if [[ "$output" == *unavailable* ]]; then
  pass
else
  fail "expected unavailable, got: $output"
fi
cleanup

report
